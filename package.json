{
  "name": "fragua",
  "version": "0.10.0",
  "private": true,
  "description": "a local dark software forge",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --silent test:node && bun run --silent test:web",
    "test:node": "bun run scripts/test-node.ts",
    "test:web": "bun run --filter=@fragua/web test",
    "ci": "bun run --silent lint && bun run --silent typecheck && bash -c 'set -o pipefail; bun run --silent test:node 2>&1 | grep -v \"^(pass) \"' && bun run --silent test:web",
    "fragua": "bun run packages/cli/bin/fragua.ts",
    "serve": "bun --hot packages/cli/bin/fragua.ts serve",
    "dev:web": "bun run --filter=@fragua/web dev",
    "build:bin": "bun run packages/cli/scripts/build-bin.ts",
    "sync-version": "bun run scripts/sync-version.ts",
    "check-version": "bun run scripts/sync-version.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "1.2.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.19.0"
  }
}
