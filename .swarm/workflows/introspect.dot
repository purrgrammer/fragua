// introspect.dot — periodic self-review of swarm's architecture, doc-implementation drift, and operational health.
//
// Read-only by construction. The codergen nodes (drift, health,
// synthesize) carry only read-style tools; collect is a deterministic
// tool node that snapshots the codebase. glob and list primitives are
// not yet shipped, bash covers filesystem enumeration in the meantime.
//
//   bun run swarm run introspect
//   bun run swarm run introspect --input="focus on the worktree subsystem"
//
// Designed to run periodically (weekly, or before releases) to catch the
// kind of drift uncovered manually in the spec/architecture review session
// of 2026-05-01. Pairs with the structural drift-lint proposal: this
// workflow produces the narrative review (prose suitable for
// release-readiness sign-off); the lint produces the pass/fail signal.
//
// Models: opus + reasoning_effort:high for the genuine reasoning work
// (drift, synthesize), applied via stylesheet `.heavy` class. `collect`
// and `health` are pure tool nodes (`.swarm/scripts/introspect/*.ts`) —
// deterministic snapshots, no LLM cost.

digraph introspect {
  graph [
    goal             = "Produce an honest, evidence-based assessment of swarm's architecture, doc-implementation drift, proposal hygiene, and operational health. Surface prioritised findings."
    label            = "introspect"
    default_fidelity = "compact"
    budget_usd       = 9.50
    budget_policy    = "warn"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; } .heavy { llm_model: claude-opus-4-7; reasoning_effort: high; }"
  ]

  start [shape=Mdiamond]

  collect [
    shape        = parallelogram
    tool_command = "bun .swarm/scripts/introspect/collect.ts $ARGUMENTS"
  ]

  drift [
    class  = "heavy"
    prompt = "Cross-reference code-vs-docs using $collect.output. Read-only; you may re-read files for confirmation but do not modify.\n\n`$collect.output` is a JSON snapshot with: `contract_files[]` (path/lines/sha256_12), `taxonomy` (run_statuses, pause_reasons, halt_reasons, quarantine_reasons, intent_types, fact_types, daemon_event_types — verbatim union literals), `schema_sql` (full schema.sql), `readme.delivers_today` / `readme.does_not_deliver` (verbatim), `proposals[]` (file/title/status/maturity/last_reviewed), `recent_commits[]`, `contract_file_history[path][]`, `skill_files[]`. Trust those values verbatim; re-read source files only when you need surrounding context.\n\nFor each contract surface, walk through and flag every discrepancy by severity. Legend: CRITICAL = wrong info that misleads readers; HIGH = missing entirely; MEDIUM = inconsistency; LOW = polish.\n\nEach finding MUST cite: (a) the code surface file:line, and (b) the documentation file:line where the surface is documented (or the explicit absence — 'NOT FOUND in ARCH §3 intent table'). A finding without both citations is invalid; re-verify or drop it. When claiming a doc 'misses' a value, grep the doc first and quote the surrounding context to prove the absence.\n\n1. Schema (schema.sql vs ARCHITECTURE.md §2) — every column, index, table, generated column, CHECK constraint\n2. Event taxonomy (swarm-events.ts vs ARCHITECTURE.md §3) — every IntentEvent / FactEvent / DaemonEvent type and payload shape; halt-reason enum; quarantine-reason enum\n3. Handler contract (handler/types.ts vs handler-contract.md) — return-kind enum; halt reasons handlers can return; HandlerContext fields; messages/artifacts API shapes\n4. Intent fold (intent-fold.ts vs docs/intent-fold.md) — precedence rules R1–R7, per-intent table including the required-state column\n5. Doc code examples — every `\\`\\`\\`typescript` / `\\`\\`\\`dot` block in docs/handler-contract.md, docs/SPEC.md, docs/ARCHITECTURE.md must call APIs that exist in current code. Flag examples using removed signatures (e.g. `messages.append(role, content)` when code is `messages.append(message)`).\n6. README 'What swarm delivers today' claims — for each, find evidence in code; flag any unbacked claim\n7. Proposal hygiene — for each status=shipped, can README claim the capability? for each status=in-progress, is the prose consistent with YAML?\n8. Recent commits (per inventory) touching contract files — any without same-PR doc updates per AGENTS.md rule #1?\n9. Swarm-* skills — for each .agents/skills/swarm-*/SKILL.md, cross-reference against the code it documents. swarm-author: DOT shapes / attrs / validator codes (E001+, W001+) / substitution tokens (every token in the table must exist in packages/core/src/engine/substitution.ts; every token in substitution.ts must be in the table) / retry-policy presets. swarm-run: HTTP route bodies (POST /runs/:id/{steer,pause,cancel,hitl,resume,unquarantine,priority}) — body shapes in skill examples must match what packages/server/src/store/routes.ts validates; flag 4xx-bouncing examples. swarm-debug: event taxonomy / halt reasons / payload field names (e.g. fact.run_paused_hitl carries `label` not `prompt`).\n\nOutput a findings table grouped by severity, with file:line refs and the exact discrepancy. No prose preamble."
    allowed_tools = "read, grep, find, bash"
    max_cost_usd  = 4.00
  ]

  health [
    shape        = parallelogram
    tool_command = "bun .swarm/scripts/introspect/health.ts"
  ]

  synthesize [
    class  = "heavy"
    prompt = "Final assessment using $collect.output, $drift.output, $health.output.\n\n`$health.output` is a JSON snapshot from the health probe: `db_status` (`ok` | `missing` | `empty`), `window` (last 7 days), `metrics[]` each with `id` (run_status_distribution / halt_reason_distribution / event_payload_size / routing_size / handler_timeout_leaks / quarantines / daemon_events_by_type), `label` (OK | WATCH | ALERT), `value`, optional `note`; and `worst_label`. Treat its labels as authoritative — don't relabel.\n\nQuote drift's findings verbatim. Do not invent terms, rephrase, or paraphrase. If drift's wording is unclear or appears to reference something that is not a real code/doc symbol (e.g. a sentence quoted from the workflow's `goal` attribute), flag it `[unclear — verify]` and pass it through unchanged rather than guessing what it meant. The synthesizer's job is consolidation and prioritisation, not re-derivation.\n\nProduce three sections in your final assistant message:\n\n1. Findings — every drift + health finding from prior nodes, grouped by severity (CRITICAL / HIGH / MEDIUM / LOW), with file:line refs. Tabular. Keep skill-drift findings as a labelled subgroup so the swarm-* skill rot is visible at a glance.\n\n2. Ratings — Idea / Architecture / Execution out of 10. Two sentences of rationale per axis. Calibrate against the prior baseline (Idea 8.5, Architecture 8, Execution 7.5 from the original audit) — say whether each score has moved and why.\n\n3. Top recommendations — 3 to 5 prioritised actions ordered by leverage. Each: one-line action; why it is load-bearing; rough scope (hours / days / weeks); whether a new proposal is warranted under docs/proposals/.\n\nSenior-engineer post-mortem tone. No emoji. No marketing language. File:line backing beats hand-wavy claims; flag low-confidence calls explicitly."
    allowed_tools = "read"
    max_cost_usd  = 2.50
  ]

  done [shape=Msquare]

  start      -> collect
  collect    -> done   [condition="outcome=fail"]
  collect    -> drift
  drift      -> health
  health     -> done   [condition="outcome=fail"]
  health     -> synthesize
  synthesize -> done
}
