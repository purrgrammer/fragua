// introspect.dot — periodic self-review of swarm's architecture, doc-implementation drift, and operational health.
//
// Read-only by construction. allowed_tools = "read, bash" on every node;
// glob and list primitive tools are not yet shipped, bash covers
// filesystem enumeration in the meantime.
//
//   bun run swarm run introspect
//   bun run swarm run introspect --input="focus on the worktree subsystem"
//
// Designed to run periodically (weekly, or before releases) to catch the
// kind of drift uncovered manually in the spec/architecture review session
// of 2026-05-01. Pairs with the structural drift-lint proposal: this
// workflow produces the narrative review (prose suitable for
// release-readiness sign-off); the lint produces the pass/fail signal.
//
// Models: sonnet for enumeration / pattern-matching (collect, health);
// opus + reasoning_effort:high for the genuine reasoning work (drift,
// synthesize) — applied via stylesheet `.heavy` class.

digraph introspect {
  graph [
    goal             = "Produce an honest, evidence-based assessment of swarm's architecture, doc-implementation drift, proposal hygiene, and operational health. Surface prioritised findings."
    label            = "introspect"
    default_fidelity = "compact"
    budget_usd       = 12.00
    budget_policy    = "warn"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; } .heavy { llm_model: claude-opus-4-7; reasoning_effort: high; }"
  ]

  start [shape=Mdiamond]

  collect [
    prompt = "Inventory swarm's current state. Read-only.\n\n$ARGUMENTS\n\nRead in full:\n- packages/store/src/schema.sql\n- packages/types/src/swarm-events.ts\n- packages/core/src/handler/types.ts\n- packages/core/src/handler/intent-fold.ts\n- docs/SPEC.md, docs/ARCHITECTURE.md, docs/handler-contract.md, docs/intent-fold.md, docs/PENDING.md\n- README.md, docs/proposals/README.md\n- every docs/proposals/*.md (front-matter plus first section is enough)\n- .agents/skills/swarm-author/SKILL.md, .agents/skills/swarm-run/SKILL.md, .agents/skills/swarm-debug/SKILL.md\n\nRun via bash:\n- git log -30 --oneline\n- git log -50 --format='%h %s' on the four contract files above\n- ls docs/proposals/\n\nOutput one structured snapshot:\n1. Authoritative surfaces — line count + sha256 first 12 chars per contract file\n2. Status enum, intent types, fact types, halt reasons, quarantine reasons (verbatim)\n3. Schema tables and columns (verbatim from schema.sql)\n4. README 'What swarm delivers today' bullets (verbatim)\n5. Proposal index — every file with title/status/maturity from front-matter\n6. Recent commits touching contract files\n7. Swarm-* skill files — line count + sha256 first 12 + the version-sensitive sections each cites (validator codes, DOT shape table, HTTP routes, event taxonomy references)\n\nDo not analyse. Do not recommend. Inventory only.\n\n<promise>INVENTORY_READY</promise>"
    allowed_tools    = "read, ls, find, bash"
    reasoning_effort = "medium"
    max_cost_usd     = 1.50
  ]

  drift [
    class  = "heavy"
    prompt = "Cross-reference code-vs-docs using $collect.output. Read-only; you may re-read files for confirmation but do not modify.\n\nFor each contract surface, walk through and flag every discrepancy by severity. Legend: CRITICAL = wrong info that misleads readers; HIGH = missing entirely; MEDIUM = inconsistency; LOW = polish.\n\nEach finding MUST cite: (a) the code surface file:line, and (b) the documentation file:line where the surface is documented (or the explicit absence — 'NOT FOUND in ARCH §3 intent table'). A finding without both citations is invalid; re-verify or drop it. When claiming a doc 'misses' a value, grep the doc first and quote the surrounding context to prove the absence.\n\n1. Schema (schema.sql vs ARCHITECTURE.md §2) — every column, index, table, generated column, CHECK constraint\n2. Event taxonomy (swarm-events.ts vs ARCHITECTURE.md §3) — every IntentEvent / FactEvent / DaemonEvent type and payload shape; halt-reason enum; quarantine-reason enum\n3. Handler contract (handler/types.ts vs handler-contract.md) — return-kind enum; halt reasons handlers can return; HandlerContext fields; messages/artifacts API shapes\n4. Intent fold (intent-fold.ts vs docs/intent-fold.md) — precedence rules R1–R7, per-intent table including the required-state column\n5. Doc code examples — every `\\`\\`\\`typescript` / `\\`\\`\\`dot` block in docs/handler-contract.md, docs/SPEC.md, docs/ARCHITECTURE.md must call APIs that exist in current code. Flag examples using removed signatures (e.g. `messages.append(role, content)` when code is `messages.append(message)`).\n6. README 'What swarm delivers today' claims — for each, find evidence in code; flag any unbacked claim\n7. Proposal hygiene — for each status=shipped, can README claim the capability? for each status=in-progress, is the prose consistent with YAML?\n8. Recent commits (per inventory) touching contract files — any without same-PR doc updates per AGENTS.md rule #1?\n9. Swarm-* skills — for each .agents/skills/swarm-*/SKILL.md, cross-reference against the code it documents. swarm-author: DOT shapes / attrs / validator codes (E001+, W001+) / substitution tokens (every token in the table must exist in packages/core/src/engine/substitution.ts; every token in substitution.ts must be in the table) / retry-policy presets. swarm-run: HTTP route bodies (POST /runs/:id/{steer,pause,cancel,hitl,resume,unquarantine,priority}) — body shapes in skill examples must match what packages/server/src/store/routes.ts validates; flag 4xx-bouncing examples. swarm-debug: event taxonomy / halt reasons / payload field names (e.g. fact.run_paused_hitl carries `label` not `prompt`).\n\nOutput a findings table grouped by severity, with file:line refs and the exact discrepancy. No prose preamble.\n\n<promise>DRIFT_READY</promise>"
    allowed_tools = "read, grep, find, bash"
    max_cost_usd  = 4.00
  ]

  health [
    prompt = "Operational health spot checks. Read-only sqlite3 queries against .swarm/swarm.db.\n\nFor each metric below, compose a sqlite3 query, run it via bash, and report the result. Stay in the last 7 days unless noted.\n\n- run-status distribution from run_state\n- halt-reason distribution from fact.run_halted events\n- event payload size: max + average + count >= 80% of 4 KB cap (3276 bytes)\n- routing size on run_state: max + average + count >= 80% of 8 KB cap (6553 bytes)\n- count of fact.handler_timeout_leaked events\n- count of fact.run_quarantined events\n- daemon_events counts by type (use the daemon_events table, not events)\n\nFor each result label OK / WATCH / ALERT. WATCH = any cap-near-miss > 0. ALERT = cap-hit-rate > 1%, quarantines > 0, or recent reaper takeover.\n\nIf .swarm/swarm.db does not exist or has no rows, report 'no operational data' and stop with the promise.\n\n<promise>HEALTH_READY</promise>"
    allowed_tools    = "read, bash"
    reasoning_effort = "low"
    max_cost_usd     = 1.00
  ]

  synthesize [
    class  = "heavy"
    prompt = "Final assessment using $collect.output, $drift.output, $health.output.\n\nQuote drift's findings verbatim. Do not invent terms, rephrase, or paraphrase. If drift's wording is unclear or appears to reference something that is not a real code/doc symbol (e.g. a sentence quoted from the workflow's `goal` attribute), flag it `[unclear — verify]` and pass it through unchanged rather than guessing what it meant. The synthesizer's job is consolidation and prioritisation, not re-derivation.\n\nProduce three sections in your final assistant message:\n\n1. Findings — every drift + health finding from prior nodes, grouped by severity (CRITICAL / HIGH / MEDIUM / LOW), with file:line refs. Tabular. Keep skill-drift findings as a labelled subgroup so the swarm-* skill rot is visible at a glance.\n\n2. Ratings — Idea / Architecture / Execution out of 10. Two sentences of rationale per axis. Calibrate against the prior baseline (Idea 8.5, Architecture 8, Execution 7.5 from the original audit) — say whether each score has moved and why.\n\n3. Top recommendations — 3 to 5 prioritised actions ordered by leverage. Each: one-line action; why it is load-bearing; rough scope (hours / days / weeks); whether a new proposal is warranted under docs/proposals/.\n\nSenior-engineer post-mortem tone. No emoji. No marketing language. File:line backing beats hand-wavy claims; flag low-confidence calls explicitly.\n\n<promise>REVIEW_READY</promise>"
    allowed_tools = "read"
    max_cost_usd  = 2.50
  ]

  done [shape=Msquare]

  start      -> collect
  collect    -> drift
  drift      -> health
  health     -> synthesize
  synthesize -> done
}
