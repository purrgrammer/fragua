// introspect.dot — periodic self-review of swarm's architecture, doc-implementation drift, and operational health.
//
// Read-only by construction. allowed_tools = "read, bash" on every node;
// glob and list primitive tools are not yet shipped, bash covers
// filesystem enumeration in the meantime.
//
//   bun run swarm run introspect
//   bun run swarm run introspect --input="focus on the worktree subsystem"
//
// Designed to run periodically (weekly, or before releases) to catch the
// kind of drift uncovered manually in the spec/architecture review session
// of 2026-05-01. Pairs with the structural drift-lint proposal: this
// workflow produces the narrative review (prose suitable for
// release-readiness sign-off); the lint produces the pass/fail signal.

digraph introspect {
  graph [
    goal             = "Produce an honest, evidence-based assessment of swarm's architecture, doc-implementation drift, proposal hygiene, and operational health. Surface prioritised findings."
    label            = "introspect"
    default_fidelity = "compact"
    budget_usd       = 5.00
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; } #synthesize { llm_model: claude-opus-4-7; reasoning_effort: high; }"
  ]

  start [shape=Mdiamond]

  collect [
    prompt = "Inventory swarm's current state. Read-only.\n\n$ARGUMENTS\n\nRead in full:\n- packages/store/src/schema.sql\n- packages/types/src/swarm-events.ts\n- packages/core/src/handler/types.ts\n- packages/core/src/handler/intent-fold.ts\n- docs/SPEC.md, docs/ARCHITECTURE.md, docs/handler-contract.md, docs/intent-fold.md, docs/PENDING.md\n- README.md, docs/proposals/README.md\n- every docs/proposals/*.md (front-matter plus first section is enough)\n\nRun via bash:\n- git log -30 --oneline\n- git log -50 --format='%h %s' on the four contract files above\n- ls docs/proposals/\n\nOutput one structured snapshot:\n1. Authoritative surfaces — line count + sha256 first 12 chars per contract file\n2. Status enum, intent types, fact types, halt reasons, quarantine reasons (verbatim)\n3. Schema tables and columns (verbatim from schema.sql)\n4. README 'What swarm delivers today' bullets (verbatim)\n5. Proposal index — every file with title/status/maturity from front-matter\n6. Recent commits touching contract files\n\nDo not analyse. Do not recommend. Inventory only.\n\n<promise>INVENTORY_READY</promise>"
    allowed_tools    = "read, bash"
    context_files    = "AGENTS.md"
    reasoning_effort = "medium"
    max_cost_usd     = 1.50
  ]

  drift [
    prompt = "Cross-reference code-vs-docs using $collect.output. Read-only; you may re-read files for confirmation but do not modify.\n\nFor each contract surface, walk through and flag every discrepancy by severity. Legend: CRITICAL = wrong info that misleads readers; HIGH = missing entirely; MEDIUM = inconsistency; LOW = polish.\n\n1. Schema (schema.sql vs ARCHITECTURE.md §2) — every column, index, table, generated column, CHECK constraint\n2. Event taxonomy (swarm-events.ts vs ARCHITECTURE.md §3) — every IntentEvent / FactEvent / DaemonEvent type and payload shape; halt-reason enum; quarantine-reason enum\n3. Handler contract (handler/types.ts vs handler-contract.md) — return-kind enum; halt reasons handlers can return\n4. Intent fold (intent-fold.ts vs docs/intent-fold.md) — precedence rules R1–R7, per-intent table\n5. README 'What swarm delivers today' claims — for each, find evidence in code; flag any unbacked claim\n6. Proposal hygiene — for each status=shipped, can README claim the capability? for each status=in-progress, is the prose consistent with YAML?\n7. Recent commits (per inventory) touching contract files — any without same-PR doc updates per AGENTS.md rule #1?\n\nOutput a findings table grouped by severity, with file:line refs and the exact discrepancy. No prose preamble.\n\n<promise>DRIFT_READY</promise>"
    allowed_tools    = "read, bash"
    reasoning_effort = "medium"
    max_cost_usd     = 1.50
  ]

  health [
    prompt = "Operational health spot checks. Read-only sqlite3 queries against .swarm/swarm.db.\n\nFor each metric below, compose a sqlite3 query, run it via bash, and report the result. Stay in the last 7 days unless noted.\n\n- run-status distribution from run_state\n- halt-reason distribution from fact.run_halted events\n- event payload size: max + average + count >= 80% of 4 KB cap (3276 bytes)\n- routing size on run_state: max + average + count >= 80% of 8 KB cap (6553 bytes)\n- count of fact.handler_timeout_leaked events\n- count of fact.run_quarantined events\n- daemon_events counts by type (use the daemon_events table, not events)\n\nFor each result label OK / WATCH / ALERT. WATCH = any cap-near-miss > 0. ALERT = cap-hit-rate > 1%, quarantines > 0, or recent reaper takeover.\n\nIf .swarm/swarm.db does not exist or has no rows, report 'no operational data' and stop with the promise.\n\n<promise>HEALTH_READY</promise>"
    allowed_tools    = "read, bash"
    reasoning_effort = "low"
    max_cost_usd     = 1.00
  ]

  synthesize [
    prompt = "Final assessment using $collect.output, $drift.output, $health.output.\n\nProduce three sections in your final assistant message:\n\n1. Findings — every drift + health finding from prior nodes, grouped by severity (CRITICAL / HIGH / MEDIUM / LOW), with file:line refs. Tabular.\n\n2. Ratings — Idea / Architecture / Execution out of 10. Two sentences of rationale per axis. Calibrate against the prior baseline (Idea 8.5, Architecture 8, Execution 7.5 from the original audit) — say whether each score has moved and why.\n\n3. Top recommendations — 3 to 5 prioritised actions ordered by leverage. Each: one-line action; why it is load-bearing; rough scope (hours / days / weeks); whether a new proposal is warranted under docs/proposals/.\n\nSenior-engineer post-mortem tone. No emoji. No marketing language. File:line backing beats hand-wavy claims; flag low-confidence calls explicitly.\n\n<promise>REVIEW_READY</promise>"
    allowed_tools    = "read"
    reasoning_effort = "high"
    max_cost_usd     = 1.50
  ]

  done [shape=Msquare]

  start      -> collect
  collect    -> drift
  drift      -> health
  health     -> synthesize
  synthesize -> done
}
