// merge.dot — rebase a branch onto main and CAS-fast-forward main.
//
// Defaults to the current worktree's branch. Pass a branch name as
// $ARGUMENTS to merge a different one. Pre-flight resolves the target and
// verifies it is mergeable; rebase runs the heavyweight conflict-resolution
// + CAS protocol with refresh of any sibling main checkout.
//
//   bun run swarm run merge                                  # current branch
//   bun run swarm run merge --input="feat/touch"             # specific branch
//   bun run swarm run merge --input="01kqhywtzwwqv5nfmc"     # run id → swarm/runs/<id>

digraph merge {
  graph [
    goal             = "Rebase the target branch onto main, resolve conflicts deterministically, CAS-fast-forward main."
    label            = "merge"
    default_fidelity = "compact"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; }"
  ]

  start [shape=Mdiamond]

  preflight [
    prompt = "Resolve and validate the target branch. Fresh thread — read state via git.\n\nIf $ARGUMENTS is non-empty, resolve it to a branch:\n  1. `git checkout \"$ARGUMENTS\"`. Success → done.\n  2. Else if `$ARGUMENTS` looks like a swarm run id (matches `^[0-9a-z]{20,}$`), try `git checkout \"swarm/runs/$ARGUMENTS\"`. Success → done.\n  3. Both fail → `<abort>branch not found or dirty checkout: <name></abort>`.\nOtherwise stay on the current HEAD.\n\nGate (any failure → `<abort>not mergeable: <reason></abort>`):\n  - inside a worktree: `git rev-parse --is-inside-work-tree` → true\n  - not on main: current branch != `main` and not detached\n  - linked worktree (otherwise this is the main checkout itself): `git rev-parse --git-common-dir` != `git rev-parse --git-dir`\n  - ahead of main: `git rev-list --count main..HEAD` > 0\n  - working tree clean: `git status --porcelain` empty\n\nEmit `READY: branch=<name>, ahead=<n>`."
    allowed_tools = "read, bash"
  ]

  rebase [
    prompt = "Rebase HEAD onto main and fast-forward main with CAS. Fresh thread — read state via git.\n\nLoop (max 7 outer attempts):\n\n  1. `old_main=$(git rev-parse main)`; `branch_tip=$(git rev-parse HEAD)`; `branch_name=$(git symbolic-ref --short HEAD)`.\n\n  2. `git rebase \"$old_main\"`. Clean → step 5.\n\n  3. CONFLICT RESOLUTION. Up to 5 rounds of `git rebase --continue`; on exhaustion `git rebase --abort && git reset --hard \"$branch_tip\"` and emit `<abort>merge_conflict: resolution exhausted</abort>`.\n\n     For each file from `git diff --name-only --diff-filter=U`:\n\n     (a) Read both sides' intent:\n         - `git log --oneline \"$old_main\"..main -- <file>` → what main added.\n         - `git log --oneline \"$old_main\"...\"$branch_tip\" -- <file>` → what your branch did.\n\n     (b) Classify and apply:\n\n         UNION-COMPATIBLE (import lists, enum variants, distinct method additions, non-overlapping object/array entries): keep both, ordered per project convention.\n\n         OVERLAPPING EDIT (same line, expression, prop value, function body): **prefer main** by default. Main already shipped; your branch is integrating with it, not rewriting it. Prefer branch only if its commit message EXPLICITLY overrides main (e.g. 'revert X', 'replace Y because …'). Absence of explicit override → keep main.\n\n         STRUCTURAL CHANGE IN MAIN (rename, removed export, signature shift, deleted file) and your branch still uses the old form: adapt branch to main. Update call sites; don't resurrect dead code.\n\n     (c) Edit to remove all conflict markers (no `<<<<<<<`, `=======`, `>>>>>>>`). `git add <file>`. Next file.\n\n     When all conflicts in the round are clear, `git rebase --continue`. Repeat if more surface on later commits.\n\n  4. CONDITIONAL SAFETY NET. Skip CI (→ step 5) iff BOTH:\n       (i) step 3 did NOT execute — no conflicted files; AND\n       (ii) main's new commits since `$old_main` touch no file your branch touches: `comm -12 <(git log --name-only --pretty=format: \"$old_main\"..HEAD | grep -v '^$' | sort -u) <(git log --name-only --pretty=format: \"$old_main\"..main | grep -v '^$' | sort -u)` is empty.\n\n     Otherwise `bun run ci`. Pass → step 5.\n\n     On CI fail, classify:\n       - failures from BRANCH behaviour (your new code's tests, your typecheck errors): fix, `git commit --amend --no-edit` or fixup, re-run CI. Max 3 fix iterations.\n       - failures from CONFLICT RESOLUTION (tests covering files you touched in (c), typecheck against main's symbols): the resolution is bad. `git reset --hard \"$branch_tip\"` and emit `<abort>merge_ci_regression: <one-line failure signature></abort>`. Operator re-enqueues.\n       - if ambiguous: treat as resolution failure. Bias correctness over completion.\n\n  5. `git update-ref refs/heads/main \"$(git rev-parse HEAD)\" \"$old_main\"`. CAS — fails if main advanced during 2-4. On CAS fail, `git reset --hard \"$branch_tip\"` and loop back to 1. On 7-attempt exhaustion: `<abort>merge_race: main advances faster than this branch rebases</abort>`.\n\n  6. REFRESH STALE MAIN CHECKOUT. After CAS, any sibling worktree on main holds old_main in index + worktree. A naive `git diff --cached` misfires (compares stale index against new HEAD, reports every merged file as a phantom revert). Detect staleness against old_main's tree.\n     `main_path=$(git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch refs[/]heads[/]main$/{print w; exit}')`\n     Empty or == `$(git rev-parse --show-toplevel)` → emit `main-checkout: none`, skip.\n     Else: `old_tree=$(git rev-parse \"$old_main^{tree}\")`, `idx_tree=$(git -C \"$main_path\" write-tree 2>/dev/null || echo DIRTY)`, and test `git -C \"$main_path\" diff --quiet`.\n     `$idx_tree` == `$old_tree` AND working tree matches index → checkout is purely stale. `git -C \"$main_path\" reset --hard refs/heads/main`. Emit `main-checkout: refreshed`.\n     Otherwise user has real in-progress work — leave it. Emit `main-checkout: skipped-dirty`.\n\n  7. DELETE THE MERGED BRANCH REF. The branch's commits are now in main; the ref is redundant. `git update-ref -d \"refs/heads/$branch_name\"` (plumbing — bypasses the porcelain safety check that refuses to delete a checked-out branch; this worktree is removed when the run ends). On failure, emit `branch-deleted: failed (<reason>)`; otherwise `branch-deleted: $branch_name`.\n\n  8. Emit `MERGED: <short-sha> (was ${old_main:0:7}; branch: $branch_name; conflicts: <N> resolved; ci: green|skipped; main-checkout: refreshed|skipped-dirty|none)`.\n\nDon't push."
    allowed_tools = "read, write, edit, bash"
    max_cost_usd  = 0.50
    max_tokens    = 1200000
  ]

  done [shape=Msquare]

  start     -> preflight
  preflight -> done   [condition="outcome=fail"]
  preflight -> rebase
  rebase    -> done
}
