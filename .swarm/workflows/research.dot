// research.dot — fetch a list of URLs, return raw markdown per URL,
// synthesise across all of them.
//
// Two-node research/synthesis pipeline driven by the `web_fetch` core
// tool. The user's input carries both the question and the source
// URLs; the agent splits them and dispatches one `web_fetch` per URL
// in raw mode (no per-URL summariser cost), then the synthesise node
// reads the full markdown of every source via the shared thread and
// produces the answer directly. Higher fidelity than per-URL
// summarisation because the final-answer model sees the cross-source
// picture.
//
// Usage:
//   bun run swarm run research --input='What changed in React 19? \
//     https://react.dev/blog/2024/12/05/react-19 \
//     https://react.dev/blog/2024/04/25/react-19-upgrade-guide'
//
// Shape:
//   start → research → synthesize → done
//
// Both nodes share `thread_id="research"`. Research emits only a
// brief manifest as its assistant text; synthesise loads
// `fidelity=full` so the prior thread (with web_fetch tool results
// carrying the raw markdown) is in its context — no markdown
// duplication into output tokens.
//
// research:
//   - Has access to web_fetch only.
//   - Extracts URLs from $ARGUMENTS, dispatches web_fetch with NO
//     `prompt` arg per URL — raw markdown returns, capped at ~50KB.
//   - Emits a brief manifest assistant message — NOT the markdown
//     verbatim. The markdown lives in the tool results, which
//     synthesise reads via the shared thread.
//
// synthesize:
//   - No tools, fidelity=full — sees research's web_fetch tool
//     results in its context.
//   - Produces the final answer with `[#N]` citations.

digraph research {
  graph [
    goal             = "Fetch a set of URLs supplied in $ARGUMENTS, extract material relevant to the user's question, and synthesise a unified answer with inline citations."
    label            = "research"
    default_fidelity = "compact"
    budget_usd       = 0.50
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; }"
  ]

  start [shape=Mdiamond]

  research [
    prompt = "Fetch the URLs the user supplied so a downstream answer can quote them.\n\nUser input: $ARGUMENTS\n\nProcedure:\n  1. The user input contains a question and one or more URLs.\n  2. Extract the URLs (any `http://` or `https://` substring is a source).\n  3. For EACH URL, call web_fetch with `url:` only. Do NOT pass a `prompt` argument — without it, web_fetch returns the page's raw markdown at full fidelity.\n     If web_fetch returns a cross-host redirect, re-call once with the redirect URL. Don't chase redirects beyond the first hop.\n     If web_fetch fails (auth-required, 4xx, 5xx, network), note the failure briefly and continue with the remaining URLs.\n  4. After every web_fetch call has settled, emit a SHORT final assistant message — only the manifest below, not the markdown.\n\nManifest format (emit verbatim, then stop):\n\n# Sources fetched\n\n**Question:** <the question, verbatim from the user input>\n\n1. <URL> — ok | redirect <target> | error <one-line reason>\n2. <URL> — …\n\nWriting rules:\n  - Be brief. The whole manifest should be < 30 lines.\n  - Do NOT include the page markdown in the manifest.\n  - Keep the URL ordering identical to the user's input order so `[#N]` citations are stable."
    thread_id     = "research"
    allowed_tools = "web_fetch"
    max_cost_usd  = 0.15
  ]

  synthesize [
    prompt = "Answer the user's question using the web_fetch tool results — they carry the FULL raw markdown of each fetched URL and are the highest-fidelity content available. The manifest gives the canonical URL ordering for citations.\n\nProcedure:\n  1. Read every web_fetch tool-result carefully.\n  2. Cross-reference: where do sources agree? disagree? what's only in one source?\n  3. Write the final reply in the shape below. Emit it verbatim — no file writes, no preamble, no postscript.\n\n# Answer\n\n## TL;DR\nOne short paragraph (3-5 sentences) answering the question directly. State confidence — high if multiple sources align, medium if one source carries the load, low if sources conflict or coverage is thin.\n\n## Detail\nThe full answer in prose, organised by sub-topic rather than by source. Cite sources inline as `[#N]` matching the URL ordering in the manifest; multiple citations as `[#1, #3]`. Quote source-specific terms verbatim when precision matters — you have the raw markdown so quotation is honest.\n\n## Sources\nA numbered list reproducing each URL from the manifest:\n  1. <URL>\n  2. <URL>\n  ...\n\nWriting rules:\n  - Cite. Every non-trivial claim must point to at least one source by [#N].\n  - Don't fabricate. If the sources don't cover something the question asks about, say so — 'sources don't address X'.\n  - Don't synthesise from absence. If only one source says something, attribute it; don't promote a single-source claim to a consensus.\n  - Be terse. The TL;DR is the headline; the Detail section earns its length only by adding cross-source insight."
    thread_id        = "research"
    fidelity         = "full"
    allowed_tools    = ""
    reasoning_effort = "medium"
    max_cost_usd     = 0.20
  ]

  done [shape=Msquare]

  start    -> research
  research -> done       [outcome=fail]
  research -> synthesize
  synthesize -> done
}
