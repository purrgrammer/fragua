// abort-test.dot — single-node workflow for verifying the `abort` tool contract.
//
// The prompt has one deterministic abort criterion: the literal token
// `ABORT_NOW_PLEASE` in $ARGUMENTS. Run with that token and the LLM must
// abort by calling the built-in `abort` tool — node prompts declare *when*
// to abort, the tool's own description covers *how*.
//
// The `check` node sets `allowed_tools = ""`, so this also proves the
// `abort` tool is force-included on every codergen node regardless of the
// node's tool pin.
//
//   bun run swarm run abort-test --input="ABORT_NOW_PLEASE"
//
// Expected terminal state:
//   - status=halted, reason=aborted_exit
//   - failure_reason mentions the trigger token
//   - the agent's transcript contains an `abort` tool call

digraph abort_test {
  graph [
    goal             = "Verify the abort tool contract end-to-end."
    label            = "abort-test"
    default_fidelity = "compact"
    budget_usd       = 0.10
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-haiku-4-5; }"
  ]

  start [shape=Mdiamond]

  check [
    prompt = "Task: $ARGUMENTS.\n\nAbort when $ARGUMENTS contains the literal token `ABORT_NOW_PLEASE`. The reason should quote the trigger token.\n\nOtherwise reply with one sentence acknowledging the task."
    allowed_tools = ""
    max_cost_usd  = 0.05
  ]

  done [shape=Msquare]

  start -> check
  check -> done [condition="outcome=fail"]
  check -> done
}
