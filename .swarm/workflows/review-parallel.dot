// review-parallel.dot — reference workflow covering every node kind.
//
// Exercises the full shape vocabulary (attractor §2.8):
//   Mdiamond      → start             (start)
//   Msquare       → exit              (done)
//   box           → codergen          (plan, approach_*, summarize)
//   diamond       → conditional       (gate)  — no prompt, edge-only
//   hexagon       → wait.human        (human_signoff)
//   component     → parallel          (explore)
//   tripleoctagon → parallel.fan_in   (pick_best)
//   parallelogram → tool              (run_tests)
//
// Notes:
//   - Parallel branches are deliberation-only (read-only tools).
//   - Fan-in with no `prompt` → attractor §4.9 heuristic reducer.
//   - Tool nodes are deterministic shell steps; stdout/exit become outcome.
//   - Conditional nodes evaluate edge conditions only; no LLM.

digraph review_parallel {
  graph [
    goal             = "Produce a ranked multi-angle review of a diff, then a signoff-gated test run."
    label            = "review-parallel"
    default_fidelity = "compact"
  ]

  start [shape=Mdiamond]

  plan [
    prompt = "Summarise $ARGUMENTS as a 3-line brief: WHAT changed, WHERE (package/path), WHY. End with `<promise>BRIEF_READY</promise>`."
    allowed_tools = "read, bash"
    provider = "anthropic"
    model = "claude-opus-4-7"
  ]

  explore [shape=component, join_policy="wait_all"]

  approach_correctness [
    prompt = "Using $plan.output, run `git diff HEAD` and list up to 3 CORRECTNESS risks (logic bugs, off-by-one, missing null checks), one per line: `RISK: <one line> (file:line)`. No risks → `NO_RISKS`. Read-only."
    allowed_tools = "read, bash"
    provider = "anthropic"
    model = "claude-opus-4-7"
  ]

  approach_style [
    prompt = "Using $plan.output, run `git diff HEAD` and list STYLE/consistency regressions: `STYLE: <one line> (file:line)`. None → `NO_FINDINGS`. Read-only."
    allowed_tools = "read, bash"
    provider = "anthropic"
    model = "claude-opus-4-7"
  ]

  approach_security [
    prompt = "Using $plan.output, run `git diff HEAD` and list SECURITY concerns (unvalidated input, secret leaks, auth bypass, injection): `SEC: <one line> (file:line)`. None → `NO_CONCERNS`. Read-only."
    allowed_tools = "read, bash"
    provider = "anthropic"
    model = "claude-opus-4-7"
  ]

  pick_best [shape=tripleoctagon]

  gate [shape=diamond]

  human_signoff [
    shape  = hexagon
    prompt = "A reviewer flagged high-risk findings. Reply `APPROVE` or `REJECT`."
  ]

  run_tests [shape=parallelogram, tool_command="bun test"]

  summarize [
    prompt = "Combine $pick_best.output and $run_tests.output into a 5-line run summary. End with `REVIEW_DONE`."
    provider = "anthropic"
    model = "claude-opus-4-7"
  ]

  done [shape=Msquare]

  start -> plan
  plan  -> explore

  explore -> approach_correctness
  explore -> approach_style
  explore -> approach_security

  approach_correctness -> pick_best
  approach_style       -> pick_best
  approach_security    -> pick_best

  pick_best -> gate

  gate -> human_signoff [condition="context.risk=high"]
  gate -> run_tests     [condition="context.risk!=high"]

  human_signoff -> run_tests
  run_tests -> summarize [condition="outcome=success"]
  run_tests -> done      [condition="outcome=fail"]
  summarize -> done
}
