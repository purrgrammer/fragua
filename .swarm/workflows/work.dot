// work.dot — triage → plan → implement → review → format → ci → commit.
//
// Replaces change.dot + feature.dot with one routed workflow. A triage
// node classifies the task (small / feature / blocked) via the `route`
// tool, and the wider pipeline shapes itself accordingly through shared
// thread context. After review, a small classifier (`needs_human`)
// decides whether the diff is contract-touching enough to warrant a
// human approver before CI.
//
// Demonstrates four primitives at once:
//   - LLM-directed routing (`routes=` + ephemeral `route` tool) on
//     `triage` and `needs_human`.
//   - Human-node routing (`kind=human` + `routes=`) on `approve`.
//   - The new edge DSL (`[outcome=fail]`, `[route=foo]`,
//     `[label="..."]`).
//   - Per-edge `label="..."` overriding the derived button text on
//     human-node edges.
//
// Cluster `cluster_dev` groups implement+review for thread-sharing
// readability; it has no runtime semantics (clusters are purely
// visual under llm-routing.md §D5).
//
//   bun run swarm run work --input="add a `touch` tool to @swarm/workspace"

digraph work {
  graph [
    goal                  = "Triage a task and route it through the right plan/implement/review/ci pipeline."
    label                 = "work"
    default_fidelity      = "compact"
    max_goal_gate_retries = 3
    model_stylesheet      = "
      *             { llm_provider: anthropic; llm_model: claude-sonnet-4-6; }
      #triage       { llm_model: claude-opus-4-7; }
      #plan         { llm_model: claude-opus-4-7; }
      #needs_human  { llm_model: claude-haiku-4-5; }
      .fix          { llm_model: claude-sonnet-4-6; }
    "
  ]

  start [shape=Mdiamond]

  triage [
    thread_id     = "dev"
    routes        = "small,feature,blocked"
    allowed_tools = "read, grep, find"
    prompt        = "Task: $ARGUMENTS.\n\nClassify with the `route` tool (call it exactly once on a response of its own):\n  - small: ≤3 packages, no shared-contract changes (HandlerContext, executor internals, store schema, event envelope), ≤500 lines non-test\n  - feature: multi-package OR shared contracts OR backed by a docs/proposals/*.md file\n  - blocked: empty / ambiguous / shipped (check proposal frontmatter `status: shipped`)\n\nRead just enough to decide. Don't plan or implement; the downstream nodes do that."
  ]

  plan [
    thread_id     = "dev"
    allowed_tools = "read, grep, find, ls"
    prompt        = "Read triage's classification from the prior message in this shared thread. Produce a numbered plan suited to that scope:\n\n  1. Files to create/modify (full paths, grouped by package for feature-scope).\n  2. Tests to add: file path, exact describe/test name, one assertion sentence.\n  3. Public exports added/changed (symbol + package).\n  4. Implementation notes per file (cite existing symbols + line numbers).\n  5. For feature-scope: cross-package dependency order; same-PR doc obligations from AGENTS.md §1.\n\nIf triage said `blocked`, abort with the reason it gave."
  ]

  subgraph cluster_dev {
    implement [
      thread_id     = "dev"
      allowed_tools = "read, write, edit, grep, bash"
      prompt        = "Implement the plan. Stay inside the package(s) it names. After edits, `bun run --filter='@swarm/<pkg>' typecheck` per modified package; cap typecheck-fix at 5 cycles per package, then abort with `typecheck blocked: <top error>`.\n\nFor every test in plan §2: grep the file for the describe/test name. If missing or weaker than promised, add it; re-typecheck.\n\nEnd with a PLAN_REALISED block listing files / tests / exports / doc_updates / skipped (one line each, with the status: created | modified | skipped | added | already-present)."
    ]

    review [
      thread_id     = "dev"
      fidelity      = "full"
      goal_gate     = true
      retry_target  = "implement"
      allowed_tools = "read, grep, bash"
      prompt        = "Judge `git diff HEAD` against PLAN_REALISED.\n\nCheck:\n  (a) Diff matches PLAN_REALISED — every claimed file/test/export is present, nothing else.\n  (b) Every test in PLAN_REALISED is realised (file exists, name matches, assertion is non-trivial).\n  (c) Bugs, type errors, security issues.\n  (d) Scope creep beyond what the triage classification justifies.\n  (e) Doc-state claims match reality — verify any prose asserting shipped / outstanding / on-paper against the filesystem.\n\nReply `APPROVE: <one line>` on success. Abort with `REJECT: <one line>. fixes: <numbered list, 1-5 items>` on rejection."
    ]
  }

  format [shape=parallelogram, tool_command="bun run format"]

  needs_human [
    thread_id     = "dev"
    routes        = "yes,no"
    allowed_tools = "read, bash"
    prompt        = "Look at `git diff HEAD` and the triage classification in the shared thread. Use the `route` tool to decide whether a human should approve this before CI:\n\n  - yes: shared contracts touched (HandlerContext, executor internals, store schema, event envelope), security-sensitive code, public API breaks, or triage said `feature`.\n  - no: contained change, no contract surface, triage said `small`.\n\nCall route() exactly once on a response of its own."
  ]

  approve [
    shape  = hexagon
    kind   = human
    text   = "Reviewer approved this change. Promote to CI?"
    routes = "yes,no,defer"
  ]

  ci [shape=parallelogram, tool_command="bun run ci", max_retries=5]

  fix [
    class         = "fix"
    allowed_tools = "read, write, edit, bash"
    max_cost_usd  = 0.30
    max_tokens    = 800000
    prompt        = "CI failed. Re-run `bun run ci` via the bash tool, read the failure log from its output, then make the minimal fix and stop — the next CI run is automatic. Don't disable tests, lower assertions, or relax linters."
  ]

  commit [
    allowed_tools = "read, write, edit, bash"
    prompt        = "Commit per AGENTS.md §Commit conventions. Fresh thread — read state via git.\n\nIf `git status --short` is empty, emit `COMMITTED: no changes`.\n\nElse: `git add` explicit paths (group related files; multi-package work may warrant multiple commits, one per logical chunk), commit each with a HEREDOC message — `[<subsystem>] imperative subject ≤72 chars` then a body that stands alone. No --amend, no --no-verify, no Co-Authored-By. On hook failure, fix the root cause and create a NEW commit. Emit `COMMITTED: <short sha or sha list>`. Don't push."
  ]

  done [shape=Msquare]

  // ─── wiring ───

  start  -> triage

  triage -> plan   [route=small,   label="Small change"]
  triage -> plan   [route=feature, label="Feature scope"]
  triage -> done   [route=blocked, label="Blocked"]

  plan      -> done       [outcome=fail]
  plan      -> implement

  implement -> done       [outcome=fail]
  implement -> review

  review    -> done       [outcome=fail]
  review    -> format

  format    -> done       [outcome=fail]
  format    -> needs_human

  needs_human -> ci       [route=no,  label="Auto-promote"]
  needs_human -> approve  [route=yes, label="Needs human"]

  approve   -> ci         [route=yes,    label="Promote"]
  approve   -> done       [route=no,     label="Send back"]
  approve   -> done       [route=defer,  label="Defer"]

  ci  -> commit  [outcome=success]
  ci  -> fix     [outcome=fail]
  fix -> ci

  commit -> done
}
