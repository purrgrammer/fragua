// health.dot — operational health snapshot of the swarm SQLite store.
//
// A single codergen node runs .swarm/scripts/health/collect.ts via the
// bash tool, then summarises the OK/WATCH/ALERT verdicts in its own
// reply. The script already labels each metric; the codergen narrates.
//
// Why a codergen, not a tool node: a workflow without an LLM has nothing
// to read its own output. Tool nodes are for side effects (CI gates,
// idempotent commands); data-gathering belongs inside a codergen.
//
//   bun run swarm run health

digraph health {
  graph [
    goal             = "Snapshot operational health of the swarm event store and narrate the OK/WATCH/ALERT verdicts."
    label            = "health"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-haiku-4-5; }"
  ]

  start [shape=Mdiamond]

  snapshot [
    prompt        = "Run `bun .swarm/scripts/health/collect.ts` and read its JSON output. Summarise as a short markdown report — your FINAL assistant message, no preamble:\n\n# Swarm health — <collected_at>\n\n## Status\n<one paragraph: worst_label, distinct counts of OK/WATCH/ALERT, db_status>\n\n## Metrics\n| Label | Metric | Value | Note |\n|---|---|---|---|\n| <OK\\|WATCH\\|ALERT> | <id> | <value> | <note or —> |\n\nQuote the script's labels verbatim. If `db_status` is `missing` or `empty`, surface that under Status and skip the Metrics table."
    allowed_tools = "bash, read"
    max_cost_usd  = 0.05
  ]

  done [shape=Msquare]

  start    -> snapshot
  snapshot -> done
}
