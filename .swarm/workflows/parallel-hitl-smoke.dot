// parallel-hitl-smoke.dot — UX smoke for parallel fan-out where one
// branch is a multi-node subgraph: codergen → wait.human → tool.
// HITL inside the branch makes sense here because there's prior
// computational work (analyze) for the operator to react to, and the
// answer routes between apply / skip — a real choice with downstream
// consequences inside the branch.
//
// Three branches:
//   - read_only — simple codergen, runs to completion
//   - analyze → confirm → apply — multi-node subgraph branch:
//       analyze (codergen) inspects the diff
//       confirm (wait.human) asks the operator to apply or skip
//       apply (parallelogram tool) runs a shell command on approval
//   - baseline — simple codergen, runs to completion
//
// Exercises sub-run subgraphs (multi-node branches), HITL inside a
// branch with prior context, and a tool step inside a sub-run.
//
//   bun run swarm run parallel-hitl-smoke

digraph parallel_hitl_smoke {
  graph [
    goal             = "Smoke: parallel fan-out with one multi-node branch (codergen → HITL → tool)."
    label            = "parallel-hitl-smoke"
    default_fidelity = "compact"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-haiku-4-5-20251001; }"
  ]

  start [shape=Mdiamond]

  spawn [shape=component, join_policy="wait_all"]

  // ── Branch 1: simple read-only summary ──────────────────────
  read_only [
    prompt        = "Reply with one short line: READ_ONLY_DONE."
    allowed_tools = ""
  ]

  // ── Branch 2: multi-node subgraph ───────────────────────────
  // analyze → confirm → apply. The operator's answer at confirm
  // decides whether apply runs or the branch short-circuits to
  // fan_in.
  analyze [
    prompt        = "Inspect a tiny imaginary diff. Output one line: PLAN <one-word summary>."
    allowed_tools = ""
  ]

  confirm [
    shape  = hexagon
    prompt = "Apply $analyze.output?"
  ]

  apply [
    shape         = parallelogram
    tool_command  = "echo APPLIED"
  ]

  // ── Branch 3: simple baseline ───────────────────────────────
  baseline [
    prompt        = "Reply with one short line: BASELINE_DONE."
    allowed_tools = ""
  ]

  combine [
    shape  = tripleoctagon
    prompt = "Summarise: did each branch finish? Use $read_only.output, $analyze.output, $baseline.output. End RANK_HIGH."
  ]

  done [shape=Msquare]

  start -> spawn

  spawn -> read_only
  spawn -> analyze
  spawn -> baseline

  read_only -> combine

  analyze -> confirm
  confirm -> apply   [label="[A] Apply"]
  confirm -> combine [label="[S] Skip"]
  apply -> combine

  baseline -> combine

  combine -> done
}
