// orchestrate.dot — decompose a task, dispatch to specialist sub-agents.
//
// Single orchestrator node with `agent` in its tool pool. The model sees
// the discovered sub-agent catalog in its system prompt (rendered iff
// `agent` is allowed) and decides per sub-task whether to spawn a named
// profile or an ad-hoc agent (passing `system_prompt` + `allowed_tools`
// inline). Parallel dispatch is implicit — pi-agent-core fires concurrent
// `agent` toolcalls when issued in one assistant message.
//
//   bun run swarm run orchestrate --input "your task here"

digraph orchestrate {
  graph [
    goal             = "Decompose a task, dispatch to named or ad-hoc sub-agents, synthesize."
    label            = "orchestrate"
    default_fidelity = "compact"
    budget_usd       = 5.00
    budget_policy    = "stop"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-opus-4-7; }"
  ]

  start [shape=Mdiamond]

  orchestrate [
    prompt = "Task (authoritative): $ARGUMENTS.\nIf empty, call the `abort` tool with reason `missing task`.\n\nDecompose into 2–5 sub-tasks (one concern each), then delegate via the `agent` tool. Don't solve.\n\nFor each sub-task:\n- Named profile fits → `agent({ agent: \"<name>\", prompt: \"<brief>\" })`. The profile carries its own tool pool.\n- Otherwise ad-hoc → `agent({ name: \"<label>\", system_prompt: \"<role>\", prompt: \"<brief>\" })`. Sub-agents inherit THIS node's pool by default (minus `agent` — no nesting). Pass `allowed_tools` only to NARROW (e.g. `[\"read\",\"grep\"]` for an analyse-only task).\n\nCap concurrent `agent` calls at 2 — issue at most 2 in any one assistant message; queue the rest until one returns. Heavy fan-out (5+ parallel sub-agents producing 100s of tool calls each) blows past the codergen handler watchdog before synthesis can run; serial pairs keep tail latency bounded.\n\nBriefs carry only the slice needed; cite paths, don't dump.\n\nDispatch sub-tasks via `agent` tool calls. When all sub-agents have returned, emit a one-line confirmation (e.g. \"DISPATCH_COMPLETE: <N> sub-agents returned\") and stop — the downstream `synthesize` node produces the final user-facing answer.\n\nIf a sub-agent aborts, narrow and re-spawn once, or proceed with a marked gap. If the task can't be decomposed, call the `abort` tool with reason `not decomposable: <reason>`."
    allowed_tools = "read, write, edit, bash, grep, find, ls, agent"
    max_cost_usd  = 3.00
    max_ms        = 5400000
    thread_id     = "orchestrate"
  ]

  synthesize [
    prompt        = "Synthesize a final answer from the sub-agent results. Reconcile conflicts; write ONE unified answer that addresses $ARGUMENTS. Don't list reports — produce a unified result."
    allowed_tools = ""
    thread_id     = "orchestrate"
    fidelity      = "full"
    max_cost_usd  = 1.50
  ]

  done [shape=Msquare]

  start -> orchestrate
  orchestrate -> done [condition="outcome=fail"]
  orchestrate -> synthesize
  synthesize -> done
}
