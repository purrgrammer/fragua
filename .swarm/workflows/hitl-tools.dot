// hitl-tools.dot — HITL smoke test using only tool nodes (no LLM).
//
// Three hexagon gates exercise the structured-HITL flow without burning
// provider tokens:
//
//   review  — 2 options, with a back-edge that loops to `prepare` so
//             "[R] Redo" exercises operator-driven revision.
//   decide  — 3 options. "[H] Hold" loops back to `decide` itself
//             (via the `hold` step) — operator can stay parked indefinitely.
//   confirm — binary yes/no.
//
// Each accelerator key is unique within its gate AND across gates so
// the operator never sees the same key meaning two different things
// over the lifetime of one run.
//
//   bun run swarm run hitl-tools
//
// Then in another terminal, after the run pauses at each hexagon:
//   curl -XPOST http://localhost:4444/api/runs/<id>/hitl \
//        -H 'content-type: application/json' \
//        -d '{"selected":"A","note":"looks good"}'

digraph hitl_tools {
  graph [
    goal  = "Exercise wait.human pause+resume across 3 gates with no LLM cost."
    label = "HITL tools (no LLM)"
  ]

  start [shape=Mdiamond]

  prepare [
    shape        = parallelogram
    tool_command = "echo 'step 1: prepare'"
  ]

  review [
    shape = hexagon
    label = "Approve the prepare step?"
  ]

  build [
    shape        = parallelogram
    tool_command = "echo 'step 2: build'"
  ]

  decide [
    shape = hexagon
    label = "Deploy, hold, or abort?"
  ]

  hold [
    shape        = parallelogram
    tool_command = "sleep 1 && echo 'held — re-prompting decide'"
  ]

  confirm [
    shape = hexagon
    label = "Push to prod?"
  ]

  deploy [
    shape        = parallelogram
    tool_command = "echo 'deploying'"
  ]

  abort [
    shape        = parallelogram
    tool_command = "echo 'aborted'"
  ]

  done [shape=Msquare]

  start   -> prepare
  prepare -> review

  review  -> build   [label="[A] Approve"]
  review  -> prepare [label="[R] Redo"]

  build   -> decide

  decide  -> confirm [label="[D] Deploy"]
  decide  -> hold    [label="[H] Hold"]
  decide  -> abort   [label="[X] Abort"]

  hold    -> decide

  confirm -> deploy  [label="[Y] Yes"]
  confirm -> abort   [label="[N] No"]

  deploy  -> done
  abort   -> done
}
