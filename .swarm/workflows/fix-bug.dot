// fix-bug.dot — reproduce, fix, regression-test.
//
//   bun run swarm run fix-bug \
//     --input="bash tool hangs when command writes to stdin"

digraph fix_bug {
  graph [
    goal             = "Turn a bug report into a minimal regression test + fix that leaves CI green."
    label            = "fix-bug"
    default_fidelity = "compact"
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-opus-4-7; }"
  ]

  start [shape=Mdiamond]

  reproduce [
    prompt = "Bug: $ARGUMENTS. Locate the affected package, write a failing test next to the source (or find an existing one), confirm it fails. Output: (1) package+file, (2) test path, (3) failing assertion."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
  ]

  fix [
    prompt = "Fix per $reproduce.output. Don't modify the reproducer unless it was wrong. After each edit, re-run the reproducer, then the full package suite. Stay in the bug's package."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
  ]

  verify [
    prompt = "Run `bun run ci`. Fix failures, iterate. Emit `CI_GREEN` when all pass."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    max_cost_usd = 0.30
    max_tokens = 800000
  ]

  summarize [
    prompt = "Write .swarm/runs/${context.graph.run_id}/summary.md: bug, root cause, fix (file:line), regression test."
    allowed_tools = "write"
    fidelity = "truncate"
  ]

  done [shape=Msquare]

  start -> reproduce -> fix -> verify
  verify -> summarize [condition="outcome=success"]
  verify -> done      [condition="outcome=fail"]
  summarize -> done
}
