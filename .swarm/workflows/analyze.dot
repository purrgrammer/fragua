// analyze.dot — mine recent swarm runs for cost / confusion / redundancy patterns.
//
// Loop A from the meta-evaluation design: discovery only. Reads the local
// swarm.db, aggregates per-workflow signals, and asks an LLM to synthesise
// evidence-backed hypotheses. Does NOT apply changes — that lives in a
// separate optimize workflow with an eval gate.
//
//   bun run swarm run analyze                                     # last 30 across all workflows
//   bun run swarm run analyze --input="--limit 50"
//   bun run swarm run analyze --input="--workflow change --limit 50"
//   bun run swarm run analyze --input="--since-days 7"

digraph analyze {
  graph [
    goal             = "Mine recent swarm runs for cost, confusion, and redundancy patterns; emit ranked, evidence-backed hypotheses for workflow improvements."
    label            = "analyze"
    default_fidelity = "compact"
    budget_usd       = 1.50
    model_stylesheet = "* { llm_provider: anthropic; llm_model: claude-sonnet-4-6; }"
  ]

  start [shape=Mdiamond]

  collect [
    shape        = parallelogram
    tool_command = "bun .swarm/scripts/analyze/collect.ts $ARGUMENTS"
  ]

  analyze [
    prompt = "You are auditing recent swarm runs to find improvement opportunities. The data was extracted by a deterministic script, not by you — trust its numbers and only quote them.\n\nThe report JSON is in your previous message as `$collect.output`. It has three sections:\n  - `totals`: run count, sum cost, sum tokens\n  - `by_workflow[]`: per-workflow aggregates including `node_profiles[]` (per-node `models`, `mean_cost_usd`, `mean_tokens`, `mean_wall_seconds`, `mean_tool_calls`, `top_tools[].{tool,mean_per_run,error_rate}`, `max_loop_count`), `halt_reasons`, `abort_hotspots`, `high_iteration_nodes`, `total_tool_calls`, `total_tool_errors`, `steer_messages[].{run_id,text}`, status/cost/token/duration percentiles, models_used\n  - `runs[]`: per-run records — terminal fact, intent counts, `per_node[]` (with `models`, `wall_seconds`, `tool_calls[]`, `tool_call_total`), `steers[].{seq,ts,text}`, input preview\n\nThe per-node `models` array tells you which model each node actually used — use it to ground any claim about model choice. The `top_tools` per node tells you what the node did with its budget (e.g. lots of `bash` = lots of shelling out; lots of `read` with high error_rate = thrashing on missing files). Steer text reveals whether human course-corrections were domain knowledge the prompt could absorb.\n\nProduce a markdown report. Emit it as your FINAL assistant message verbatim — no file writes, no preamble, no postscript. The report itself becomes the durable `analyze:output` artifact in the store.\n\nUse exactly these headings:\n\n# Swarm Analysis — <ISO date from collected_at>\n\n## Scope\nOne paragraph. Total runs, distinct workflows, time window, sum cost. State the sample-size caveat: workflows with <3 runs get listed but not analysed.\n\n## Per-workflow findings\nFor each workflow with n_runs >= 3, a `### <workflow>` subsection containing:\n\n**Health.** Status mix, cost p50/p90, token p50/p90, mean duration, models used. One paragraph.\n\n**Hypotheses.** Up to 5, ranked by `impact * confidence`. Each hypothesis is a numbered item with these labelled lines:\n  - **Claim:** one sentence describing the pattern.\n  - **Evidence:** specific run_ids and numbers from the JSON. Cite at least two data points.\n  - **Proposed change:** concrete edit — prompt rewording, max_retries adjustment, model swap, context_files addition, splitting a node, removing a tool from allowed_tools, etc. Reference the .dot file by name (e.g. `merge.dot`, node `rebase`).\n  - **Confidence:** low | medium | high — and one sentence on why.\n  - **Estimated impact:** cost delta in $ or %, OR token delta, OR 'reliability' (with a number — e.g. 'eliminates 2/12 halts').\n\nIf a workflow has zero confusion signals (no aborts, steers, retargets, halts) and tight cost variance, say so explicitly — 'no actionable hypotheses; workflow appears healthy'. Don't manufacture findings.\n\n## Workflows below sample threshold\nList <workflow> (n=N): not analysed. One line each.\n\n## Cross-workflow observations\nOnly if applicable. Examples: same model is dominant cost driver across workflows; cache-read ratio low across the board; etc. Skip the section if there's nothing meaningful to say across workflows.\n\nWriting rules:\n  - Cite numbers, not vibes. 'rebase node averages $0.11/run (3 runs)' beats 'rebase is expensive'.\n  - Don't propose changes you can't justify with the data. If your only evidence is one run, your confidence is low and you should probably skip the hypothesis.\n  - Don't invent fields not in the JSON. If a signal you'd want isn't collected, note it under a final '## Signals not collected' section so we know to extend the script."
    allowed_tools    = "read"
    context_files    = "AGENTS.md"
    reasoning_effort = "high"
    max_cost_usd     = 1.20
  ]

  done [shape=Msquare]

  start   -> collect
  collect -> done    [condition="outcome=fail"]
  collect -> analyze
  analyze -> done
}
