// build-feature.dot — swarm builds a feature on its own codebase.
//
//   bun run swarm run build-feature \
//     --input="add a new tool named `touch` to @swarm/workspace"
//
// Stages: plan (read-only) → implement → review (fresh thread) → verify →
// update_docs → commit → merge. `thread_id="dev"` shares context between
// implement and fix so the fixer remembers the edits; every other stage
// runs on a fresh thread and reads state via git. AGENTS.md is
// auto-prepended to every codergen system prompt by the agent backend.

digraph build_feature {
  graph [
    goal             = "Land a reviewable feature change on swarm. Human merges the diff."
    label            = "build-feature"
    default_fidelity = "compact"
  ]

  start [shape=Mdiamond]

  plan [
    prompt = "Task (authoritative, do not substitute): $ARGUMENTS.\n\nABORT conditions:\n  - empty, names nothing specific, or blocked → `<abort>missing or blocked target: <reason></abort>`\n  - touches >3 packages OR shared contracts (HandlerContext, BuildContextOpts, executor internals, core engine reducers, store schema, event envelope) → `<abort>scope too large: <what></abort>`\n  - estimated >500 lines of non-test code → `<abort>too large, split: <suggested split></abort>`\n\nProduce a numbered plan:\n  1. Files to create/modify (full paths).\n  2. Tests to add. Each: (a) full path, (b) exact `describe`/`test` name, (c) one concrete assertion sentence.\n  3. Public exports to add/change (symbol + package).\n  4. Implementation notes per file. Cite existing symbols + line numbers.\n  5. Conventions to flag (pure core, spec-first, no silent deps, etc.).\n\nEnd with `<promise>PLAN_READY</promise>`."
    allowed_tools = "read"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  implement [
    prompt = "Implement $plan.output. Stay inside the package(s) the plan names. Do NOT modify docs/SPEC.md or AGENTS.md unless the plan says so.\n\nAfter edits, `bun run --filter='@swarm/<pkg>' typecheck` on every modified package; fix errors. Cap typecheck-fix cycles at 5 per package — if still red, emit `<abort>typecheck blocked: <top error></abort>`.\n\nBefore finishing: for each test item in $plan.output section 2, grep the test file for the `describe`/`test` name. If missing or weaker than promised, add it, re-run typecheck on its package, re-verify.\n\nSummarise: files touched, public surface, each planned test name (one per line), any skipped items + why."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  review [
    prompt = "Judge the diff, not the process. Inputs: $plan.output, $implement.output, `git diff HEAD`.\n\nCheck:\n  (a) Diff implements the plan — no more, no less.\n  (b) Every plan §2 test is realised: file exists, name matches, assertions match.\n  (c) Bugs, type errors, security issues.\n  (d) Scope creep — files outside the plan OR shared contracts not listed.\n\nReply EXACTLY one of:\n  `APPROVE: <one line>`\n  `<abort>REJECT_FIXABLE: <one line>. fixes: <numbered list, 1-3 mechanical items></abort>`\n  `<abort>REJECT: <one line — architecture, scope creep, contract violation></abort>`\n\nREJECT_FIXABLE only when every fix is narrow, mechanical, and needs no re-plan. Otherwise REJECT. If unsure, REJECT."
    allowed_tools = "read, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  fix [
    prompt = "$review.output rejected with a numbered fix list. Apply the fixes verbatim — no new behaviour, no re-architecture, no edits outside files the review names.\n\nABORT:\n  - marker is `REJECT:` (not `REJECT_FIXABLE:`) → `<abort>not fixable: structural change required</abort>`\n  - fix needs files outside $plan.output's file list → `<abort>fix outside plan scope: <file></abort>`\n  - >5 edits needed → `<abort>fix list too broad, needs re-plan</abort>`\n\nFor each numbered fix: apply, typecheck the touched package, run the test file if one was added.\n\nEmit `FIXED: <n> items applied, typecheck clean`."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
    max_retries = 0
  ]

  verify [
    prompt = "Run `bun run ci`. Fix failures, iterate. Cap: 5 rounds — then `<abort>CI unstable: <last failure signature></abort>`. Don't disable tests or relax assertions. Emit `CI_GREEN` on a clean run."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-sonnet-4-6"
    max_cost_usd = 0.30
    max_tokens = 800000
  ]

  update_docs [
    prompt = "`git diff --stat HEAD`. If empty or only internal source/tests changed, emit `DOCS_READY: no changes`. Only user-visible shifts (public APIs, CLI flags, workflow contracts, repo layout, stack) warrant updates. Edit docs/SPEC.md / docs/ARCHITECTURE.md / AGENTS.md as needed — minimal, on-topic, nothing outside those files. Emit `DOCS_READY: updated <files>` or `DOCS_READY: no changes`."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  commit [
    prompt = "Commit per AGENTS.md §Commit conventions. If `git status --short` is empty, emit `COMMITTED: no changes`. Otherwise: `git add` explicit paths, commit with a HEREDOC message — `[<subsystem>] imperative subject ≤72 chars` then a body that stands alone as a run summary. No --amend, no --no-verify, no Co-Authored-By. On hook failure, fix the root cause and create a NEW commit. Emit `COMMITTED: <short sha>`. Don't push."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  merge [
    prompt = "Rebase this worktree's branch onto main and fast-forward main. Fresh thread — read state via git.\n\nSkip (emit `MERGE_SKIPPED: <reason>` and stop) if: not inside a work tree; `git-common-dir` == `git-dir` (main checkout, not linked); on main or detached; no commits ahead of main.\n\nOtherwise, loop (max 7 outer attempts):\n\n  1. `old_main=$(git rev-parse main)`; `branch_tip=$(git rev-parse HEAD)`.\n\n  2. `git rebase \"$old_main\"`. If it completes cleanly, go to step 5.\n\n  3. CONFLICT RESOLUTION PROTOCOL. Up to 5 rounds of `git rebase --continue`; on exhaustion `git rebase --abort && git reset --hard \"$branch_tip\"` and emit `<abort>merge_conflict: resolution exhausted</abort>`.\n\n     For each file listed by `git diff --name-only --diff-filter=U`:\n\n     (a) Read BOTH sides' intent before editing:\n         - `git log --oneline \"$old_main\"..main -- <file>` → commits main added since your branch point. Read the messages.\n         - `git log --oneline \"$old_main\"...\"$branch_tip\" -- <file>` → what your branch was trying to do. Read the messages.\n\n     (b) Classify the conflict and apply the matching rule:\n\n         UNION-COMPATIBLE (import lists, enum variants, non-overlapping array/object entries, distinct method additions on the same interface): keep both sides, ordered per project convention.\n\n         OVERLAPPING EDIT TO THE SAME CONSTRUCT (same line, expression, prop value, function body): **prefer main** by default. Main has already been reviewed and shipped; your branch is integrating with it, not rewriting it. Only prefer branch if branch's commit message EXPLICITLY states it's overriding main's change (e.g. 'revert X', 'replace invalidateQueries with refetchQueries because …'). Absence of explicit override language → keep main.\n\n         STRUCTURAL CHANGE IN MAIN (rename, removed export, signature shift, deleted file) and your branch still uses the old form: adapt branch to main. Update your call sites to main's new shape; do not resurrect dead code.\n\n     (c) Edit the file to eliminate all conflict markers (no `<<<<<<<`, `=======`, `>>>>>>>` may remain). `git add <file>`. Move to the next conflicted file.\n\n     When all conflicts in the current `git rebase --continue` round are resolved, run `git rebase --continue`. Repeat if more conflicts surface on subsequent commits.\n\n  4. CONDITIONAL SAFETY NET. CI's job here is to catch (a) bad conflict resolutions and (b) main introducing changes that break files your branch touches. `verify` already ran CI on this exact tree, so when neither (a) nor (b) can apply, re-running CI is dead time during which main can advance and lose you the CAS race.\n\n     Skip CI (go directly to step 5) iff BOTH:\n       (i) step 3 did NOT execute — i.e. the rebase surfaced no `git diff --name-only --diff-filter=U` files (the `Current branch is up to date` no-op qualifies); AND\n       (ii) main's new commits since `$old_main` touch no file your branch touches: `comm -12 <(git log --name-only --pretty=format: \"$old_main\"..HEAD | grep -v '^$' | sort -u) <(git log --name-only --pretty=format: \"$old_main\"..main | grep -v '^$' | sort -u)` is empty.\n\n     Otherwise run `bun run ci`. If CI passes → step 5.\n\n     If CI fails, classify:\n       - If failures stem from behaviour your BRANCH introduced (tests for your new code, your typecheck errors): fix, `git commit --amend --no-edit` (or a fixup commit), re-run CI. Max 3 fix iterations.\n       - If failures stem from YOUR CONFLICT RESOLUTION (tests that cover code you touched during resolution, typecheck errors against main's symbols): the resolution is bad and you can't re-do it safely from here. `git reset --hard \"$branch_tip\"` and emit `<abort>merge_ci_regression: <one-line failure signature></abort>`. The operator will re-enqueue.\n       - If you cannot confidently tell which it is, treat as conflict-resolution failure. Bias toward correctness over completing the merge.\n\n  5. `git update-ref refs/heads/main \"$(git rev-parse HEAD)\" \"$old_main\"`. CAS — fails if main advanced during steps 2-4. On CAS failure, `git reset --hard \"$branch_tip\"` and loop back to step 1 (rebase against the new main). On 7-attempt exhaustion: `<abort>merge_race: main advances faster than this branch rebases</abort>`.\n\n  6. REFRESH THE STALE MAIN CHECKOUT. Git advanced `refs/heads/main` via CAS, but any sibling worktree with main checked out still holds old_main's tree in BOTH its index and working tree. A naive `git diff --cached` check misfires: it compares the stale index against the NEW HEAD and reports every merged file as 'staged changes reverting the merge', so we'd skip the reset and leave phantom staged reversions behind — stage-and-commit there would literally revert this merge. Detect staleness against old_main's tree, not against new HEAD.\n     Resolve its path: `main_path=$(git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch refs[/]heads[/]main$/{print w; exit}')`\n     If `$main_path` is empty or equals `$(git rev-parse --show-toplevel)`, emit `main-checkout: none` and skip.\n     Otherwise compute: `old_tree=$(git rev-parse \"$old_main^{tree}\")`, `idx_tree=$(git -C \"$main_path\" write-tree 2>/dev/null || echo DIRTY)` (write-tree is non-destructive; fails on an unmerged index, which we treat as dirty), and test `git -C \"$main_path\" diff --quiet` (working tree matches index).\n     If `$idx_tree` == `$old_tree` AND the working tree matches the index: the checkout is purely stale — both mirror old_main exactly, no user work. `git -C \"$main_path\" reset --hard refs/heads/main`. Emit `main-checkout: refreshed`.\n     Otherwise the user has real in-progress work — leave it alone. Emit `main-checkout: skipped-dirty`.\n\n  7. Emit `MERGED: <short-sha> (was ${old_main:0:7}; conflicts: <N> resolved; ci: green; main-checkout: refreshed|skipped-dirty|none)`.\n\nDon't push."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  done [shape=Msquare]

  start -> plan

  // <abort> → outcome=fail → route straight to done. Condition edges are
  // evaluated before unconditional ones (see docs/SPEC.md §3.6).
  plan -> done [condition="outcome=fail"]
  plan -> implement

  implement -> done [condition="outcome=fail"]
  implement -> review

  // REJECT_FIXABLE routes through fix; REJECT (architecture) terminates.
  // Both come through as outcome=fail — fix itself aborts for non-fixable
  // review outputs, so the distinction is enforced by the fix prompt.
  review -> fix  [condition="outcome=fail", label="rejected"]
  review -> verify

  fix -> done   [condition="outcome=fail"]
  fix -> verify

  verify -> update_docs [condition="outcome=success"]
  verify -> done        [condition="outcome=fail"]
  update_docs -> commit
  commit -> merge
  merge -> done
}
