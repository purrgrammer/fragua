// change.dot — daily driver: plan → implement → review → verify → commit.
//
// REJECT loops back to implement automatically. Review is goal-gated with
// retry_target=implement, and the §3.4 retarget chain is capped by
// graph.max_goal_gate_retries (=2 here) so a stubborn reviewer can't burn
// the run forever. Merge is a separate workflow — `swarm run merge` after.
//
//   bun run swarm run change \
//     --input="add a `touch` tool to @swarm/workspace"

digraph change {
  graph [
    goal                  = "Land a reviewable change on swarm. Plan, implement, review, verify, commit."
    label                 = "change"
    default_fidelity      = "compact"
    max_goal_gate_retries = 2
    model_stylesheet      = "
      *           { llm_provider: anthropic; llm_model: claude-opus-4-7; }
      .verify     { llm_model: claude-sonnet-4-6; }
      .commit     { llm_model: claude-haiku-4-6; }
      #review     { llm_model: claude-sonnet-4-6; }
    "
  ]

  start [shape=Mdiamond]

  plan [
    prompt = "Task (authoritative, do not substitute): $ARGUMENTS.\n\nAbort when:\n  - empty / blocked / names nothing specific\n  - touches >3 packages OR shared contracts (HandlerContext, executor internals, store schema, event envelope)\n  - >500 lines of non-test code\n\nRead just enough to plan. Output a numbered plan:\n  1. Files to create/modify (full paths).\n  2. Tests to add: file path, exact `describe`/`test` name, one assertion sentence.\n  3. Public exports added/changed (symbol + package).\n  4. Implementation notes per file. Cite existing symbols + line numbers."
    allowed_tools = "read, grep, find"
    context_files = "AGENTS.md"
  ]

  // Cluster: implement + review share thread `dev` so the reviewer sees the
  // implementer's session. The `cluster_dev` id derives class `dev` for any
  // future stylesheet rule on that scope.
  subgraph cluster_dev {
    implement [
      prompt = "Implement $plan.output. Stay inside the package(s) the plan names. Don't touch docs/SPEC.md or AGENTS.md unless the plan says so.\n\nAfter edits, `bun run --filter='@swarm/<pkg>' typecheck` per modified package; fix errors. Cap typecheck-fix at 5 cycles per package — then abort with reason `typecheck blocked: <top error>`.\n\nFor every test in plan §2: grep the file for the `describe`/`test` name. If missing or weaker than promised, add it; re-typecheck.\n\nSummarise: files touched, public surface, planned tests realised, skipped items + why."
      allowed_tools = "read, write, edit, grep, bash"
      thread_id     = "dev"
    ]

    review [
      prompt = "Judge the diff. Inputs: $plan.output, $implement.output, `git diff HEAD`.\n\nCheck:\n  (a) Diff implements the plan — no more, no less.\n  (b) Every plan §2 test is realised (file exists, name matches, assertion matches).\n  (c) Bugs, type errors, security issues.\n  (d) Scope creep — files outside the plan OR shared contracts not listed.\n  (e) Doc-state claims match reality. Any prose edit that asserts shipped / landed / outstanding / on-paper / in-progress — verify against the filesystem with `ls` / `grep`, don't trust the words on the page. Reality wins. If the diff says something is 'still outstanding' that already exists on disk, REJECT.\n\nIf approved, reply `APPROVE: <one line>`. If rejected, abort with reason `REJECT: <one line>. fixes: <numbered list, 1-5 items>`.\n\nBe strict. Implement re-runs automatically on REJECT (capped at 2 cycles)."
      allowed_tools = "read, grep, bash"
      thread_id     = "dev"
      goal_gate     = true
      retry_target  = "implement"
    ]
  }

  verify [
    class         = "verify"
    prompt        = "Run `bun run ci`. Fix failures, iterate. Cap: 5 fix rounds — then abort with reason `CI unstable: <last failure signature>`. Don't disable tests or relax assertions. Emit `CI_GREEN` on a clean run."
    allowed_tools = "read, write, edit, bash"
    max_cost_usd  = 0.30
    max_tokens    = 800000
  ]

  commit [
    class         = "commit"
    prompt        = "Commit per AGENTS.md §Commit conventions. Fresh thread — read state via git.\n\nIf `git status --short` is empty, emit `COMMITTED: no changes`.\n\nOtherwise: `git add` explicit paths, commit with a HEREDOC message — `[<subsystem>] imperative subject ≤72 chars` then a body that stands alone. No --amend, no --no-verify, no Co-Authored-By. On hook failure, fix the root cause and create a NEW commit. Emit `COMMITTED: <short sha>`. Don't push."
    allowed_tools = "read, write, edit, bash"
    context_files = "AGENTS.md"
  ]

  done [shape=Msquare]

  start  -> plan
  plan   -> done [condition="outcome=fail"]
  plan   -> implement

  implement -> done [condition="outcome=fail"]
  implement -> review

  // REJECT routes via this fail edge to terminal. Goal-gate enforcement at
  // the terminal sees review unsatisfied and retargets to retry_target=
  // implement. The cycle caps at max_goal_gate_retries.
  review -> done [condition="outcome=fail"]
  review -> verify

  verify -> done [condition="outcome=fail"]
  verify -> commit
  commit -> done
}
