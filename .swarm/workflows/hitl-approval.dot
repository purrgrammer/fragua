// hitl-approval.dot — two human-in-the-loop checkpoints.
//
// review (hexagon) shows [A]pprove / [R]evise buttons.
// confirm (hexagon) shows [P]ublish / [C]ancel buttons.
// Edge routing is driven by the handler's suggestedNextIds — no conditions needed.
//
//   bun run swarm run hitl-approval \
//     --input="draft a changelog entry for the new HITL UI"

digraph hitl_approval {
  graph [
    goal             = "Produce an artifact the human explicitly signed off on."
    label            = "HITL approval"
    default_fidelity = "compact"
  ]

  start [shape=Mdiamond]

  draft [
    prompt = "Draft the artifact: $ARGUMENTS. Under 200 words. End with `<promise>DRAFT_READY</promise>`."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  review [
    shape  = hexagon
    label  = "Review the draft"
  ]

  confirm [
    shape  = hexagon
    label  = "Publish this artifact?"
  ]

  publish [
    prompt = "Publish the approved artifact. End with `PUBLISHED: <ref>`."
    allowed_tools = "read, write, edit, bash"
    llm_provider = "anthropic"
    llm_model = "claude-opus-4-7"
  ]

  done [shape=Msquare]

  start  -> draft
  draft  -> review

  review -> confirm [label="[A] Approve"]
  review -> draft   [label="[R] Revise"]

  confirm -> publish [label="[P] Publish"]
  confirm -> done    [label="[C] Cancel"]

  publish -> done
}
