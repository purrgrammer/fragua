// fix-bug.dot — reproduce, fix, regression-test.
//
// Run:
//   bun run packages/cli/bin/swarm.ts run workflows/fix-bug.dot \
//     --input="grep tool crashes on empty files"

digraph fix_bug {
  graph [
    goal        = "Turn a bug report into a minimal regression test + fix that leaves CI green."
    label       = "swarm: fix-bug"
    default_fidelity = "compact"
    default_max_retries = 1
    retry_target = "fix"
  ]

  start [shape=Mdiamond]

  reproduce [
    prompt = "Bug report: $ARGUMENTS\n\nStep 1 — Reproduce.\n  - Use local:grep and local:read_file to find the code paths that match the bug description.\n  - If a reproducer already exists (a failing test), describe where.\n  - Otherwise, write a new failing test (prefer test/ next to the affected source). Run `bun test ./packages/<pkg>` with local:bash and confirm it fails.\n  - Output: (1) the affected package + file, (2) the reproducer test path, (3) the failing assertion text."
    allowed_tools = "local:read_file, local:grep, local:glob, local:list_dir, local:write_file, local:bash"
    max_retries = 1
    thread_id = "dev"
  ]

  fix [
    prompt = "Fix plan: $reproduce.output.\n\nRules:\n  - Use local:edit_file for surgical changes (include enough surrounding context that old_string is unique).\n  - Do not modify the reproducer test unless it was itself wrong.\n  - After each edit, run the reproducer test. When it passes, run the full package suite.\n  - Do not touch packages outside the one where the bug lives.\n\nOutput a concise description of the fix."
    allowed_tools = "local:read_file, local:edit_file, local:write_file, local:bash"
    max_retries = 2
    thread_id = "dev"
  ]

  verify [
    prompt = "Run `bun run ci` with local:bash. If green, emit `CI_GREEN`. If not, diagnose and go back through local:edit_file + local:bash until it passes. Max 3 iterations here."
    allowed_tools = "local:read_file, local:edit_file, local:bash"
    max_retries = 2
    goal_gate = true
    thread_id = "dev"
  ]

  summarize [
    prompt = "Write .swarm/runs/${context.graph.run_id}/summary.md with:\n  - Bug: $ARGUMENTS\n  - Root cause\n  - Fix (which file(s) / line(s))\n  - Regression test added\n\nUse local:write_file."
    allowed_tools = "local:write_file"
    fidelity = "truncate"
  ]

  done [shape=Msquare]

  start -> reproduce -> fix -> verify
  verify -> summarize [condition="outcome=success"]
  verify -> done [condition="outcome=fail"]
  summarize -> done
}
