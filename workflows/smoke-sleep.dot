// smoke-sleep.dot — no-LLM smoke workflow for executor concurrency.
//
// Three sequential `sleep 5` tool nodes per run (~15s total) — long
// enough to comfortably watch the run sit in `running` on the
// dashboard. Enqueue N runs back-to-back and they should all reach
// 'running' at the same time under the fire-and-forget executor; a
// serial `await runOne` would serialise them at ~15s each.
//
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   curl http://localhost:4444/api/runs   # expect 3 × status=running

digraph smoke_sleep {
  graph [
    goal  = "Exercise the executor concurrency path without hitting any LLM."
    label = "smoke-sleep"
  ]

  start [shape=Mdiamond]
  s1    [shape=parallelogram, tool_command="sleep 5", timeout="30s"]
  s2    [shape=parallelogram, tool_command="sleep 5", timeout="30s"]
  s3    [shape=parallelogram, tool_command="sleep 5", timeout="30s"]
  done  [shape=Msquare]

  start -> s1
  s1    -> s2   [condition="outcome=success"]
  s1    -> done [condition="outcome=fail"]
  s2    -> s3   [condition="outcome=success"]
  s2    -> done [condition="outcome=fail"]
  s3    -> done
}
