// smoke-sleep.dot — no-LLM smoke workflow for executor concurrency.
//
// Two sequential `sleep 2` tool nodes per run. Enqueue N runs back-to-back
// and they should all reach 'running' at the same time under the A.1
// fire-and-forget executor. A serial `await runOne` executor would
// serialise them at ~4s each.
//
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   bun run packages/cli/bin/swarm.ts run workflows/smoke-sleep.dot
//   curl http://localhost:4444/api/runs   # expect 3 × status=running

digraph smoke_sleep {
  graph [
    goal  = "Exercise the executor concurrency path without hitting any LLM."
    label = "smoke-sleep"
  ]

  start [shape=Mdiamond]
  s1    [shape=parallelogram, tool_command="sleep 2"]
  s2    [shape=parallelogram, tool_command="sleep 2"]
  done  [shape=Msquare]

  start -> s1
  s1    -> s2   [condition="outcome=success"]
  s1    -> done [condition="outcome=fail"]
  s2    -> done
}
