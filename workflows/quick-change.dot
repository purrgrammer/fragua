// quick-change.dot — small self-contained changes: code → verify → commit → merge.
//
// For typo fixes, tiny refactors, dep bumps. Anything needing explore/review
// goes through build-feature.dot instead.
//
//   bun run packages/cli/bin/swarm.ts run workflows/quick-change.dot \
//     --input="rename foo() to bar() in packages/core"
//
// Hardening notes (2026-04-21):
//   - implement must ABORT on ambiguous input rather than silently guess
//   - verify caps its own retry count so a stuck CI doesn't spin forever

digraph quick_change {
  graph [
    goal  = "Land a small, self-contained change on swarm, rebased onto main."
    label = "quick-change"
  ]

  start [shape=Mdiamond]

  implement [
    prompt = "Task (authoritative, do not substitute): $ARGUMENTS.\n\nABORT conditions — emit the marker and stop:\n  - empty or ill-specified → `<abort>missing or blocked target</abort>`\n  - ambiguous (multiple reasonable interpretations) → `<abort>ambiguous: <specific question the user must answer></abort>`\n  - needs exploration, a plan, multi-package refactor, or shared-contract changes (HandlerContext, BuildContextOpts, executor internals, core engine reducers) → `<abort>task too large for quick-change: use build-feature</abort>`\n  - forbidden files are docs/SPEC.md, docs/PLAN.md, AGENTS.md — emit abort if the task requires touching them\n\nOTHERWISE implement the change. Rules:\n  - Stay in the package(s) named by the task. Don't drift.\n  - After edits, `bun run --filter='@swarm/<pkg>' typecheck` per modified package; fix errors. If typecheck still fails after 3 iterations, emit `<abort>typecheck blocked: <top error></abort>`.\n  - Don't add tests unless the task explicitly asks (quick-change is for changes small enough that verify catches regressions).\n\nEmit `IMPLEMENTED: <one-line summary of files touched>` on success."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    model = "claude-sonnet-4-6"
    max_retries = 0
  ]

  verify [
    prompt = "Run `bun run ci`. If it fails, FIX the regression and re-run. Cap: 3 fix iterations. If CI is still red after 3 rounds, emit `<abort>CI unstable: <last failure signature></abort>` — don't keep burning budget.\n\nDo NOT disable tests, skip test files, or relax assertions to go green. That's what the failure signature is for. If a test is genuinely broken (pre-existing, unrelated to $implement.output), say so in the abort reason rather than silently skipping it.\n\nEmit `CI_GREEN` on a clean run."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    model = "claude-sonnet-4-6"
    max_retries = 0
  ]

  commit [
    prompt = "Commit per AGENTS.md §Commit conventions. Fresh thread — read state via git. If `git status --short` is empty, emit `COMMITTED: no changes`. Otherwise: pick `[P<n>]` phase tag from docs/PLAN.md (prefer in-progress phase on doubt), `git add` explicit paths, commit with a HEREDOC message (imperative subject ≤72 chars; body explains why). No --amend, no --no-verify, no Co-Authored-By. On hook failure, fix the root cause and create a NEW commit. Emit `COMMITTED: <short sha>`. Don't push."
    allowed_tools = "read, write, edit, bash"
    model = "claude-sonnet-4-6"
  ]

  merge [
    prompt = "Rebase this worktree's branch onto main and fast-forward main. Fresh thread — read state via git.\n\nSkip (emit `MERGE_SKIPPED: <reason>` and stop) if: not inside a work tree; `git-common-dir` == `git-dir` (main checkout, not linked); on main or detached; no commits ahead of main.\n\nOtherwise, loop (max 3 outer attempts):\n\n  1. `old_main=$(git rev-parse main)`; `branch_tip=$(git rev-parse HEAD)`.\n\n  2. `git rebase \"$old_main\"`. If it completes cleanly, go to step 5.\n\n  3. CONFLICT RESOLUTION PROTOCOL. Up to 5 rounds of `git rebase --continue`; on exhaustion `git rebase --abort && git reset --hard \"$branch_tip\"` and emit `<abort>merge_conflict: resolution exhausted</abort>`.\n\n     For each file listed by `git diff --name-only --diff-filter=U`:\n\n     (a) Read BOTH sides' intent before editing:\n         - `git log --oneline \"$old_main\"..main -- <file>` → commits main added since your branch point. Read the messages.\n         - `git log --oneline \"$old_main\"...\"$branch_tip\" -- <file>` → what your branch was trying to do. Read the messages.\n\n     (b) Classify the conflict and apply the matching rule:\n\n         UNION-COMPATIBLE (import lists, enum variants, non-overlapping array/object entries, distinct method additions on the same interface): keep both sides, ordered per project convention.\n\n         OVERLAPPING EDIT TO THE SAME CONSTRUCT (same line, expression, prop value, function body): **prefer main** by default. Main has already been reviewed and shipped; your branch is integrating with it, not rewriting it. Only prefer branch if branch's commit message EXPLICITLY states it's overriding main's change (e.g. 'revert X', 'replace invalidateQueries with refetchQueries because …'). Absence of explicit override language → keep main.\n\n         STRUCTURAL CHANGE IN MAIN (rename, removed export, signature shift, deleted file) and your branch still uses the old form: adapt branch to main. Update your call sites to main's new shape; do not resurrect dead code.\n\n     (c) Edit the file to eliminate all conflict markers (no `<<<<<<<`, `=======`, `>>>>>>>` may remain). `git add <file>`. Move to the next conflicted file.\n\n     When all conflicts in the current `git rebase --continue` round are resolved, run `git rebase --continue`. Repeat if more conflicts surface on subsequent commits.\n\n  4. DETERMINISTIC SAFETY NET. After the rebase completes cleanly, run `bun run ci`.\n\n     If CI passes → step 5.\n\n     If CI fails, classify:\n       - If failures stem from behaviour your BRANCH introduced (tests for your new code, your typecheck errors): fix, `git commit --amend --no-edit` (or a fixup commit), re-run CI. Max 3 fix iterations.\n       - If failures stem from YOUR CONFLICT RESOLUTION (tests that cover code you touched during resolution, typecheck errors against main's symbols): the resolution is bad and you can't re-do it safely from here. `git reset --hard \"$branch_tip\"` and emit `<abort>merge_ci_regression: <one-line failure signature></abort>`. The operator will re-enqueue.\n       - If you cannot confidently tell which it is, treat as conflict-resolution failure. Bias toward correctness over completing the merge.\n\n  5. `git update-ref refs/heads/main \"$(git rev-parse HEAD)\" \"$old_main\"`. CAS — fails if main advanced during steps 2-4. On CAS failure, `git reset --hard \"$branch_tip\"` and loop back to step 1 (rebase against the new main). On 3-attempt exhaustion: `<abort>merge_race: main advances faster than this branch rebases</abort>`.\n\n  6. REFRESH THE STALE MAIN CHECKOUT. Git advanced `refs/heads/main` via CAS, but any sibling worktree with main checked out still has the old tree and will report phantom unstaged changes on its next `git status`. Resolve its path:\n     `main_path=$(git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch refs[/]heads[/]main$/{print w; exit}')`\n     If `$main_path` is non-empty and not equal to `$(git rev-parse --show-toplevel)`: run `git -C \"$main_path\" diff --quiet && git -C \"$main_path\" diff --cached --quiet`. If clean, `git -C \"$main_path\" reset --hard refs/heads/main` to resync its working tree. If dirty, leave it alone — the user has in-progress work.\n\n  7. Emit `MERGED: <short-sha> (was ${old_main:0:7}; conflicts: <N> resolved; ci: green; main-checkout: refreshed|skipped-dirty|none)`.\n\nDon't push."
    allowed_tools = "read, write, edit, bash"
    model = "claude-sonnet-4-6"
  ]

  done [shape=Msquare]

  start -> implement
  implement -> done   [condition="outcome=fail"]
  implement -> verify
  verify -> commit [condition="outcome=success"]
  verify -> done   [condition="outcome=fail"]
  commit -> merge
  merge -> done
}
