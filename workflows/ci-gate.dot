// ci-gate.dot — lint → typecheck → test, halt on first failure.
//
// All tool nodes (parallelogram), no LLM. `tool_command` substitutes
// $ARGUMENTS / ${context.*}; exit 0 → success, non-zero → fail.
//
//   bun run packages/cli/bin/swarm.ts run workflows/ci-gate.dot

digraph ci_gate {
  graph [
    goal  = "Run lint, typecheck, and tests in sequence. Halt on first failure."
    label = "ci-gate"
  ]

  start [shape=Mdiamond]

  lint      [shape=parallelogram, tool_command="bun run lint"]
  typecheck [shape=parallelogram, tool_command="bun run --filter='*' typecheck"]
  test      [shape=parallelogram, tool_command="bun test $ARGUMENTS"]

  done [shape=Msquare]

  start     -> lint
  lint      -> typecheck [condition="outcome=success"]
  lint      -> done      [condition="outcome=fail"]
  typecheck -> test      [condition="outcome=success"]
  typecheck -> done      [condition="outcome=fail"]
  test      -> done
}
