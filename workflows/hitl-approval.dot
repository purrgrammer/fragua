// hitl-approval.dot — two human-in-the-loop checkpoints.
//
// review (hexagon) emits `hitl.review`; confirm (hexagon) emits `hitl.confirm`.
// Edge conditions route on literal match — no parsing node needed.
//
//   bun run packages/cli/bin/swarm.ts run workflows/hitl-approval.dot \
//     --input="draft a changelog entry for the new HITL UI"
//   bun run packages/cli/bin/swarm.ts resume <run-id> --input="APPROVED"
//   bun run packages/cli/bin/swarm.ts resume <run-id> --input="REVISE: tighten summary"

digraph hitl_approval {
  graph [
    goal  = "Produce an artifact the human explicitly signed off on."
    label = "HITL approval"
  ]

  start [shape=Mdiamond]

  draft [
    prompt = "Draft the artifact: $ARGUMENTS. If the prior reviewer said `REVISE: <note>` (see context.hitl.review), address it. Under 200 words. End with `<promise>DRAFT_READY</promise>`."
    allowed_tools = "read, write, edit, bash"
  ]

  review [
    shape  = hexagon
    prompt = "Read the current draft. Reply `APPROVED` or `REVISE: <note>`."
  ]

  confirm [
    shape  = hexagon
    prompt = "Publish this artifact? Reply `PUBLISH` or `CANCEL`."
  ]

  publish [
    prompt = "Publish the approved artifact. End with `PUBLISHED: <ref>`."
    allowed_tools = "read, write, edit, bash"
  ]

  done [shape=Msquare]

  start  -> draft
  draft  -> review

  // APPROVED → confirm. Anything else (including REVISE:) loops back to draft.
  review -> confirm [condition="context.hitl.review=APPROVED"]
  review -> draft

  // PUBLISH → publish. Anything else (CANCEL, etc.) bails.
  confirm -> publish [condition="context.hitl.confirm=PUBLISH"]
  confirm -> done

  publish -> done
}
