// build-feature.dot — swarm builds a feature on its own codebase.
//
// This is the critical self-hosting workflow. All nodes use the CLI's default
// model so the same file works across providers. Override per-run:
//
//   # Anthropic direct (default if ANTHROPIC_API_KEY is set)
//   bun run packages/cli/bin/swarm.ts run workflows/build-feature.dot \
//     --provider anthropic --model claude-opus-4-7 \
//     --input="add local:list_dir tool that lists files in a directory"
//
//   # OpenRouter (300+ models through one key)
//   bun run packages/cli/bin/swarm.ts run workflows/build-feature.dot \
//     --provider openrouter --model "anthropic/claude-opus-4.7" \
//     --input="..."
//
// Stages:
//   1. explore             — read the repo, identify target package + tests
//   2. plan                — produce a concrete change list + test plan
//   3. implement_and_review — trapezium loop: edit files, spawn a subagent
//                             as read-only reviewer, iterate until the
//                             reviewer emits <promise>APPROVED</promise>
//                             or max_iterations=3 is hit
//   4. verify              — run `bun run ci` and iterate on failures
//   5. update_docs         — sync docs/SPEC.md, docs/PLAN.md, AGENTS.md if
//                             user-visible behavior / conventions shifted
//   6. commit              — stage touched files and commit per AGENTS.md
//                             §Commit conventions (imperative, [P<n>] tag,
//                             no --no-verify)
//   7. summarize           — write a PR-style summary to .swarm/runs/<id>/summary.md

digraph build_feature {
  graph [
    goal        = "Land a reviewable feature change on swarm. Human merges the diff."
    label       = "swarm self-hosting: build-feature"
    default_fidelity = "compact"
    default_max_retries = 1
    retry_target = "implement_and_review"
  ]

  start [shape=Mdiamond]

  explore [
    prompt = "You are a senior engineer working on swarm (a universal AI agent orchestrator).\n\nTask from user (authoritative — do NOT substitute): $ARGUMENTS\n\nIf $ARGUMENTS names a specific task spec (e.g. a `tasks/<phase>/NN-*.md` file) or a specific feature, that IS the target for this run. You may not pick a different task on the grounds that it is smaller, more unblocking, a prerequisite, or a better fit. If you believe the named task is blocked or ill-specified, STOP and emit `EXPLORE_BLOCKED: <one-line reason>` instead of silently retargeting.\n\nStep 1 — Explore:\n  - Read docs/SPEC.md and docs/PLAN.md for the project vision and current phase.\n  - The repo conventions from AGENTS.md have been prepended as <project-conventions> above — follow them.\n  - If $ARGUMENTS references a file path, read that file first and let its scope constrain the rest of this step.\n  - Use local:bash to run `git ls-files | head -40` to understand layout.\n  - Identify which package(s) the task targets and which tests already cover similar ground.\n  - Output a short summary under 600 words describing what you found. Begin the summary with a one-line `Target:` field quoting the specific task, file, or feature named by $ARGUMENTS (or `Target: <free-form>` if no specific task was named)."
    allowed_tools = "local:read_file, local:bash"
    context_files = "AGENTS.md"
  ]

  plan [
    prompt = "Original task from user (authoritative — do NOT substitute): $ARGUMENTS\n\nYour plan must target exactly the task, file(s), or feature named above. Do not retarget to a different task even if exploration surfaced a smaller/easier/more-unblocking alternative — that is a bug, not an optimisation. If $ARGUMENTS references a `tasks/<phase>/NN-*.md` file, every `Files to create or modify` entry in your plan must be consistent with that spec's Scope section (you may add supporting files, but you may not drop in-scope files or add files that belong to a different task).\n\nBased on your exploration ($explore.output) and the task above, produce a concrete plan as a numbered list:\n  1. Files to create or modify (full paths).\n  2. Tests to add (full paths + what they verify).\n  3. Public exports to add/change.\n  4. Any constraints you want to flag before implementation.\n\nHonour the repo conventions in <project-conventions> (AGENTS.md) above — especially `pure core`, `spec-first`, and `no silent deps`.\n\nEnd the plan with a single line: `<promise>PLAN_READY</promise>`. Do not call any tools in this node."
    fidelity = "compact"
    context_files = "AGENTS.md"
  ]

  implement_and_review [
    shape = trapezium
    until = "APPROVED"
    max_iterations = 3
    prompt = "You are implementing the plan ($plan.output).\n\nEach iteration, do all three steps in order:\n  (1) IMPLEMENT — apply any remaining plan items using local:read_file, local:write_file, local:bash. Stay inside the package(s) named in the plan. After editing, run `bun run --filter='@swarm/<pkg>' typecheck` on every modified package and fix any errors. Do NOT modify docs/SPEC.md or docs/PLAN.md unless the plan says to.\n  (2) REVIEW — call local:subagent with: prompt = the full plan + a diff of what you changed (from `git diff`) + this instruction: \"You are a senior reviewer. Read the listed files and judge whether the implementation matches the plan, tests cover the new behavior, and there are no obvious bugs or scope creep. Respond with either \\\"APPROVE: <one-line reason>\\\" or \\\"REJECT: <numbered list of concrete fixes>\\\".\" Set allowed_tools to [\"local:read_file\",\"local:bash\"] (read-only reviewer).\n  (3) DECIDE — if the reviewer's verdict starts with APPROVE, emit exactly <promise>APPROVED</promise> as your final message (nothing else). If it starts with REJECT, acknowledge the fixes you will make next iteration and STOP (the loop will re-invoke you)."
    allowed_tools = "local:read_file, local:write_file, local:bash, local:subagent"
    thread_id = "dev"
  ]

  verify [
    prompt = "Run `bun run ci` and report the result. If anything fails, read the error, fix the code with local:write_file, and run again. Max 3 iterations. When green, emit the literal string `CI_GREEN` in your final reply."
    allowed_tools = "local:read_file, local:write_file, local:bash"
    max_retries = 2
    goal_gate = true
    thread_id = "dev"
  ]

  update_docs [
    prompt = "Decide whether this run's changes need to be reflected in the repo's docs.\n\nSteps:\n  1. Run `git diff --stat HEAD` and then `git diff HEAD` via local:bash to see everything implement_and_review produced.\n  2. For each of the following, decide if an update is warranted:\n       - docs/SPEC.md   — user-visible behavior, invariants, or public contracts changed\n       - docs/PLAN.md   — phase scope or a phase's verification bar shifted\n       - AGENTS.md      — conventions, commands, repo layout, or stack changed\n     Cosmetic/internal refactors that a reader of the docs would not notice do NOT need doc updates.\n  3. If none apply, emit exactly `DOCS_READY: no changes` and stop.\n  4. Otherwise, edit the affected docs with local:write_file. Keep edits minimal and on-topic — do not rewrite sections that weren't affected. Do not touch any files outside docs/*.md and AGENTS.md.\n  5. Emit `DOCS_READY: updated <comma-separated file list>` as your final line."
    allowed_tools = "local:read_file, local:write_file, local:bash"
    fidelity = "compact"
    thread_id = "dev"
  ]

  commit [
    prompt = "Commit this run's work following AGENTS.md §Commit conventions. Use local:bash for every git call.\n\nSteps:\n  1. `git status --short` — if there are no changes, emit `COMMITTED: no changes` and stop.\n  2. `git diff --stat` — enumerate the files you will stage.\n  3. Pick the phase tag: `grep -n '^## Phase' docs/PLAN.md`, read the surrounding text, and choose `[P<n>]` for the lowest-numbered phase whose verification bar this change advances. When uncertain, prefer the current in-progress phase over speculating about later ones.\n  4. Stage explicitly: `git add <path1> <path2> ...`. Never `git add .` or `git add -A`.\n  5. Commit with a HEREDOC so quoting survives:\n       git commit -m \"$(cat <<'EOF'\n       [P<n>] <imperative one-line subject, <=72 chars>\n\n       <optional body explaining why, wrapped at 72 cols. Omit if the subject is self-explanatory.>\n       EOF\n       )\"\n     Rules: imperative mood (\"add X\", not \"added X\"); no `--no-verify`; no `Co-Authored-By` line; no marketing language.\n  6. If the pre-commit hook fails, fix the root cause (typecheck/lint/test error) with local:write_file, re-stage the fix, and create a NEW commit — never `git commit --amend`. One retry only; if it still fails, emit `COMMIT_FAILED: <short reason>` and stop.\n  7. `git status` must be clean. Emit `COMMITTED: <short sha from git rev-parse --short HEAD>` as the final line.\n\nDo not run `git push`."
    allowed_tools = "local:read_file, local:write_file, local:bash"
    max_retries = 1
    thread_id = "dev"
  ]

  summarize [
    prompt = "Write a PR-style summary of the change to .swarm/runs/${context.graph.run_id}/summary.md. Include:\n  - What changed (bullet list of files + one line each)\n  - Why (cite the user's request: $ARGUMENTS)\n  - Test evidence (from the verify step)\n  - Commit SHA (from $commit.output, if available)\n\nUse local:write_file. Keep it under 400 words."
    allowed_tools = "local:write_file"
    fidelity = "truncate"
  ]

  done [shape=Msquare]

  start -> explore -> plan -> implement_and_review -> verify
  verify -> update_docs [condition="outcome=success"]
  verify -> done        [condition="outcome=fail"]
  update_docs -> commit
  commit -> summarize
  summarize -> done
}
