// build-feature.dot — swarm builds a feature on its own codebase.
//
//   bun run packages/cli/bin/swarm.ts run workflows/build-feature.dot \
//     --input="add a new tool named `touch` to @swarm/workspace"
//
// Stages: plan (read-only) → implement → review (fresh thread) → verify →
// update_docs → commit → merge. `thread_id="dev"` shares context between
// implement and verify so the verifier remembers edits; every other stage
// runs on a fresh thread and reads state via git. AGENTS.md is attached to
// plan via context_files; downstream nodes cite any rule inline.

digraph build_feature {
  graph [
    goal  = "Land a reviewable feature change on swarm. Human merges the diff."
    label = "build-feature"
  ]

  start [shape=Mdiamond]

  plan [
    prompt = "Task (authoritative, do not substitute): $ARGUMENTS.\n\nIf $ARGUMENTS is empty, names nothing specific, or the target is blocked, emit `<abort>missing or blocked target: <reason></abort>`. Do NOT retarget silently. If $ARGUMENTS references `tasks/<phase>/NN-*.md`, its Scope section is authoritative.\n\nYou have read-only tools. Read docs/SPEC.md, docs/PLAN.md, any file named in $ARGUMENTS, and (if relevant) a skill's SKILL.md.\n\nProduce a numbered plan:\n  1. Files to create/modify (full paths).\n  2. Tests to add (full paths + what they verify).\n  3. Public exports to add/change.\n  4. Implementation notes per file — specific enough that a cheaper model can execute without further discovery. Cite existing symbols + line numbers.\n  5. Conventions to flag (pure core, spec-first, no silent deps, etc.).\n\nEnd with `<promise>PLAN_READY</promise>`."
    allowed_tools = "read"
    context_files = "AGENTS.md"
  ]

  implement [
    prompt = "Implement $plan.output. Stay inside the package(s) the plan names. After edits, `bun run --filter='@swarm/<pkg>' typecheck` on every modified package; fix errors. Do NOT modify docs/SPEC.md, docs/PLAN.md, or AGENTS.md unless the plan says so. Summarise: files touched, public surface, tests, any skipped plan items + why."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    model = "anthropic/claude-sonnet-4.6"
  ]

  review [
    prompt = "Fresh thread. Judge the diff, not the process. Inputs: $plan.output, $implement.output, and `git diff HEAD`.\n\nCheck:\n  (a) Diff implements the plan — no more, no less.\n  (b) New behavior is covered by tests that assert what the plan said.\n  (c) Obvious bugs, type errors the compiler missed, security issues.\n  (d) Scope creep — edits outside the plan's named files.\n\nReply EXACTLY one of:\n  APPROVE: <one line>\n  <abort>REJECT: <one line>. fixes: <numbered list, 1-4 items></abort>\n\nDon't hedge. If unsure, REJECT with a concrete concern. Read-only tools."
    allowed_tools = "read, bash"
    model = "anthropic/claude-sonnet-4.6"
  ]

  verify [
    prompt = "Run `bun run ci`. Fix failures, iterate. Emit `CI_GREEN` when all pass."
    allowed_tools = "read, write, edit, bash"
    thread_id = "dev"
    model = "anthropic/claude-sonnet-4.6"
  ]

  update_docs [
    prompt = "Fresh thread — read state via git. `git diff --stat HEAD`. If empty, emit `DOCS_READY: no changes`. If only internal source/tests changed (nothing a docs reader would notice), emit `DOCS_READY: no changes`. Only user-visible shifts (public APIs, CLI flags, workflow contracts, repo layout, stack) warrant updates. Edit docs/SPEC.md / docs/PLAN.md / AGENTS.md as needed — minimal, on-topic, nothing outside those files. Emit `DOCS_READY: updated <files>` or `DOCS_READY: no changes`."
    allowed_tools = "read, write, edit, bash"
    model = "anthropic/claude-sonnet-4.6"
  ]

  commit [
    prompt = "Commit per AGENTS.md §Commit conventions. Fresh thread — read state via git. If `git status --short` is empty, emit `COMMITTED: no changes`. Otherwise: pick `[P<n>]` phase tag from docs/PLAN.md (prefer current in-progress phase on doubt), `git add` explicit paths, commit with a HEREDOC message (imperative subject ≤72 chars; body stands alone as run summary). No --amend, no --no-verify, no Co-Authored-By. On hook failure, fix the root cause and create a NEW commit. Keep iterating until it lands. Emit `COMMITTED: <short sha>`. Don't push."
    allowed_tools = "read, write, edit, bash"
    model = "anthropic/claude-sonnet-4.6"
  ]

  merge [
    prompt = "Rebase this worktree's branch onto main and fast-forward main. Fresh thread — read state via git.\n\nSkip (emit `MERGE_SKIPPED: <reason>` and stop) if:\n  - not inside a work tree\n  - `git-common-dir` == `git-dir` (main checkout, not a linked worktree)\n  - on `main` or detached\n  - no commits ahead of main\n\nOtherwise:\n  1. `old_main=$(git rev-parse main)`\n  2. `git rebase \"$old_main\"`. On conflicts, resolve by keeping both sides when semantically possible (concatenate lists, union imports, merge type members); only drop one side on literal contradiction. Max 5 conflict rounds. On exhaustion: `git rebase --abort` and emit `<abort>merge conflicts unresolved</abort>`.\n  3. `git update-ref refs/heads/main \"$(git rev-parse HEAD)\" \"$old_main\"` (CAS — fails if main advanced). On CAS failure, loop back to step 1. Max 3 outer attempts; on exhaustion emit `<abort>merge race</abort>`.\n  4. Emit `MERGED: <short-sha> (was ${old_main:0:7})`.\n\nDon't push."
    allowed_tools = "read, write, edit, bash"
    model = "anthropic/claude-sonnet-4.6"
  ]

  done [shape=Msquare]

  start -> plan

  // <abort> → outcome=fail → route straight to done. Condition edges are
  // evaluated before unconditional ones (see docs/SPEC.md §3.8).
  plan -> done [condition="outcome=fail"]
  plan -> implement

  implement -> review
  review -> done [condition="outcome=fail", label="rejected"]
  review -> verify

  verify -> update_docs [condition="outcome=success"]
  verify -> done        [condition="outcome=fail"]
  update_docs -> commit
  commit -> merge
  merge -> done
}
