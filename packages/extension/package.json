{
  "name": "@swarm/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Type-only API for swarm tool extensions",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.71.0",
    "@mariozechner/pi-ai": "0.71.0",
    "@sinclair/typebox": "0.34.41",
    "@swarm/core": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "lucide-react": "1.14.0",
    "react": "18.3.1",
    "typescript": "5.7.3"
  }
