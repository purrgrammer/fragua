# Provider API keys — set the one(s) you actually use. swarm refuses to
# run a node against a provider whose env var is missing and prints the
# exact variable name you need.
#
# `swarm providers add [provider]` is the interactive equivalent — it
# writes credentials into ~/.swarm/auth.json (mode 0600) instead.
#
# See docs/providers.md for the inference-provider vs. model-provider
# distinction, and packages/cli/README.md for the full operations
# reference.

# Direct providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Aggregators (model id is namespaced, e.g. anthropic/claude-haiku-4.5)
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# google-vertex — set GOOGLE_CLOUD_API_KEY, OR run
# `gcloud auth application-default login` and set:
GOOGLE_CLOUD_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# amazon-bedrock — any of: AWS_PROFILE, AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY,
# AWS_BEARER_TOKEN_BEDROCK, or one of the container/IRSA variables.

# github-copilot — checks COPILOT_GITHUB_TOKEN, then GH_TOKEN, then GITHUB_TOKEN.
