// fix-bug.dot — reproduce → fix → detect → verify.
//
// Pattern: evaluator-optimizer with a self-retarget. The `reproduce` node
// is goal-gated: a fix without a failing test first is a no-op, so if
// reproduce fails to land an asserting test the run retargets back to
// it (capped by max_goal_gate_retries=2).
//
// Runtime-agnostic. A `detect_test_runner` tool node probes the project's
// check command from manifest files (package.json → bun/pnpm/yarn/npm,
// Makefile, pyproject.toml, Cargo.toml, go.mod, composer.json, Gemfile,
// mix.exs) and feeds the result to `verify` as $detect_test_runner.output.
// If nothing is discoverable the run terminates at `done` without burning
// a verify turn.
//
// EXTERNAL DEPENDENCY: detect_test_runner shells to
// `$HOME/.swarm/scripts/fix-bug/detect-runner.sh`. A reference
// implementation lives at `examples/workflows/fix-bug/detect-runner.sh`;
// install it to `~/.swarm/scripts/fix-bug/` before running.
//
//   swarm run fix-bug --input="bash tool hangs when command writes to stdin"

digraph fix_bug {
  graph [
    goal                  = "Turn a bug report into a minimal regression test + fix that leaves CI green."
    label                 = "fix-bug"
    default_fidelity      = "compact"
    max_goal_gate_retries = 2
    model_stylesheet      = "
      *        { llm_provider: anthropic; llm_model: claude-opus-4-7; }
      .verify  { llm_model: claude-sonnet-4-6; }
    "
  ]

  start [shape=Mdiamond]

  reproduce [
    prompt = "Bug: $ARGUMENTS.\n\nAbort when: empty / unclear / cannot localise to a file or module after a reasonable read.\n\nOtherwise: locate the affected scope, write a failing test using whatever framework the repo already uses (jest/vitest/mocha, pytest/unittest, go test, cargo test, phpunit, rspec, junit, …) placed in the conventional location for that ecosystem (alongside the source, in `tests/`, in `__tests__/`, in `src/test/…`, etc. — match what's already there). Confirm it fails. Output: (1) source file + test file paths, (2) test identifier (function name, describe block, or equivalent), (3) failing assertion sentence."
    allowed_tools = "read, write, edit, grep, find, bash"
    thread_id     = "dev"
    goal_gate     = true
    retry_target  = "reproduce"
  ]

  fix [
    prompt = "Fix the bug against the failing test the reproducer landed (source + test paths and test identifier are above). Don't modify the reproducer unless it was wrong. After each edit, re-run the reproducer first, then the surrounding scope's tests (the package, module, crate, or directory the reproducer lives in). Stay inside that scope; don't refactor unrelated code."
    allowed_tools = "read, write, edit, grep, bash"
    thread_id     = "dev"
    fidelity      = "full"
  ]

  detect_test_runner [shape=parallelogram, tool_command="$HOME/.swarm/scripts/fix-bug/detect-runner.sh"]

  verify [
    class         = "verify"
    prompt        = "Run `$detect_test_runner.output` in the project root. Fix failures, iterate. Cap: 5 rounds — then call the `abort` tool with reason `CI unstable: <last failure signature>`. Don't disable tests, lower assertions, or relax linters. Emit `CI_GREEN: $detect_test_runner.output` when all pass."
    allowed_tools = "read, write, edit, bash"
    thread_id     = "dev"
    max_cost_usd  = 0.30
    max_tokens    = 800000
  ]

  done [shape=Msquare]

  start -> reproduce
  reproduce -> done [condition="outcome=fail"]
  reproduce -> fix

  fix -> done              [condition="outcome=fail"]
  fix -> detect_test_runner

  detect_test_runner -> verify [condition="outcome=success"]
  detect_test_runner -> done   [condition="outcome=fail"]

  verify -> done
}
