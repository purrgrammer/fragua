// hello.dot — tiny linear smoke workflow.
//
// Run:   bun run packages/cli/bin/swarm.ts run examples/hello.dot --input="swarm"
// Replay:bun run packages/cli/bin/swarm.ts replay .swarm/runs/<id>/events.jsonl

digraph hello {
  graph [
    goal = "Greet the user and log the result."
    default_fidelity = "truncate"
  ]

  start  [shape=Mdiamond]
  greet  [
    goal_gate = true
    prompt = "Write a friendly one-line greeting to greeting.txt for $ARGUMENTS. Keep it under 60 characters. Use the local:write_file tool."
    allowed_tools = "local:write_file"
  ]
  verify [
    prompt = "Read greeting.txt with local:read_file and confirm it was written."
    allowed_tools = "local:read_file"
  ]
  done   [shape=Msquare]

  start -> greet -> verify -> done [condition="outcome=success"]
  greet -> done [condition="outcome=fail"]
  verify -> done [condition="outcome=fail"]
}
